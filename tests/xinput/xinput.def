LIBRARY winpad-xinput.dll
; xinput1_3's ordinals, for a game that imports by number.
EXPORTS
    XInputGetState@8 @2
    XInputSetState@8 @3
    XInputGetCapabilities@12 @4
    XInputEnable@4 @5
    XInputGetDSoundAudioDeviceGuids@12 @6
    XInputGetBatteryInformation@12 @7
    XInputGetKeystroke@12 @8
    XInputGetAudioDeviceIds@20 @9
    XInputGetStateEx@8 @100 NONAME
