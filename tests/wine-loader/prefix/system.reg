WINE REGISTRY Version 2
;; All keys relative to \\Machine
;; The registry a WoW64 prefix starts from (run-host.sh). wineboot, which
;; registers the builtin COM classes on desktop Wine, never runs on iOS, and
;; a prefix with no system.reg has none, so CoCreateInstance fails with
;; REGDB_E_CLASSNOTREG. These are the 32-bit registrations of the classes the
;; x86 test programs need. Without a system.reg the server would make the
;; CurrentControlSet link itself; with one it has to be here.

#arch=win64

[Software\\Classes\\Wow6432Node\\CLSID\\{BCDE0395-E52F-467C-8E3D-C4579291692E}] 1729468800
@="MMDeviceEnumerator class"

[Software\\Classes\\Wow6432Node\\CLSID\\{BCDE0395-E52F-467C-8E3D-C4579291692E}\\InprocServer32] 1729468800
@="mmdevapi.dll"
"ThreadingModel"="Both"

[System\\ControlSet001] 1729468800

[System\\CurrentControlSet] 1729468800
#link
"SymbolicLinkValue"=hex(6):5c,00,52,00,65,00,67,00,69,00,73,00,74,00,72,00,79,00,5c,00,4d,00,61,00,63,00,68,00,69,00,6e,00,65,00,5c,00,53,00,79,00,73,00,74,00,65,00,6d,00,5c,00,43,00,6f,00,6e,00,74,00,72,00,6f,00,6c,00,53,00,65,00,74,00,30,00,30,00,31,00
