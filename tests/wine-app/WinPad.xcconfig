// WinPad Wine's switches for this project (Xcode reads it for every target).
//
// WINPAD_VPN = YES: the app carries its own loopback VPN (VPN/, PlugIns/WinPadVPN.appex) for
// the built-in JIT, so that LocalDevVPN is not needed. It needs the Network Extension
// capability, which only a paid Apple developer account can sign; with a free account keep NO
// (the app then uses LocalDevVPN). xcodebuild takes it on the command line too: WINPAD_VPN=YES.
WINPAD_VPN = NO

WINPAD_VPN_ENTITLEMENTS_YES = VPN/WinPadVPN.entitlements
WINPAD_VPN_ENTITLEMENTS_NO =

// WINPAD_MEMORY = YES: the app asks for iPadOS's increased memory limit
// (com.apple.developer.kernel.increased-memory-limit), so a game may use more of the iPad's
// RAM before iPadOS ends it. If Xcode says the signing team does not support it, set NO.
WINPAD_MEMORY = YES

// The app's entitlements: WINPAD_APP_ENTITLEMENTS_<VPN>_<MEMORY>.
WINPAD_APP_ENTITLEMENTS_NO_NO =
WINPAD_APP_ENTITLEMENTS_NO_YES = WinPadMemory.entitlements
WINPAD_APP_ENTITLEMENTS_YES_NO = VPN/WinPadVPN.entitlements
WINPAD_APP_ENTITLEMENTS_YES_YES = VPN/WinPadVPN+Memory.entitlements
