+// Same layout as RelocGuestRIP up to GuestRIP, so guest RIP rebasing treats both alike
+struct RelocAOTBlockTail final {
+  RelocationHeader Header {};
+
+  // Bytes from the tail to the end of the block (tail and RIP entries)
+  uint32_t TailSize;
+
+  // The block's entry RIP, relative to the binary base in a serialized cache
+  uint64_t GuestRIP;
+
+  // Offset from the block's JITCodeHeader to the tail
+  uint32_t OffsetFromHeader;
+
+  uint32_t pad2[5] {};
+};
+
