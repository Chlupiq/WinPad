+static_assert(offsetof(RelocAOTBlockTail, GuestRIP) == offsetof(RelocGuestRIP, GuestRIP));
+static_assert(sizeof(RelocAOTBlockTail) == sizeof(RelocGuestRIP));
+
+// Number of 8-byte data area slots a relocation takes in an AOT code cache
+constexpr uint64_t AOTDataSlotCount(const Relocation& Reloc) {
+  switch (Reloc.Header.Type) {
+  case RelocationTypes::RELOC_GUEST_RIP_DATA_SLOT: return 1;
+  case RelocationTypes::RELOC_GUEST_RIP_LINK_RECORD: return 3;
+  case RelocationTypes::RELOC_AOT_BLOCK_TAIL: return (Reloc.AOTBlockTail.TailSize + 7) / 8;
+  default: return 0;
+  }
+}
