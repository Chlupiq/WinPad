+// WinPad: on iOS nothing can be mapped below 4 GiB, so a 32-bit guest lives in a 4 GiB window of host
+// memory and guest address G is host address Base + G (GuestWindow in the WoW64 module). The compiler
+// keeps one such window for the images it compiles: FEXCore reads guest code at GUEST32BASE + RIP, and
+// the trackers below speak host addresses, as in the WoW64 module. 0 when there is no window.
+namespace IosGuestWindow {
+uint64_t Base {};
+constexpr uint64_t Size {1ULL << 32};
+
+static bool Contains(uint64_t Host) {
+  return Host >= Base && Host - Base < Size;
+}
