+#if defined(FEX_IOS_HOST) && !defined(ARCHITECTURE_arm64ec)
+// WinPad: lays the image out by hand at its preferred base inside the guest window (host Base +
+// ImageBase). A SEC_IMAGE view cannot be used: Madeira's ntdll would place it outside the window and
+// relocate it to that 64-bit host address, which a 32-bit image cannot hold. At its preferred base the
+// image needs no relocation, and ImageTracker still records its relocation table for the cache.
+// Returns the host address of the image.
+static void* LoadImageIntoGuestWindow(HANDLE File, std::string_view Filename) {
+  LARGE_INTEGER FileSize {};
+  if (!GetFileSizeEx(File, &FileSize) || FileSize.QuadPart < static_cast<LONGLONG>(sizeof(IMAGE_DOS_HEADER))) {
+    return nullptr;
+  }
+  fextl::vector<uint8_t> Data(static_cast<size_t>(FileSize.QuadPart));
+  DWORD Read = 0;
+  if (!ReadFile(File, Data.data(), static_cast<DWORD>(Data.size()), &Read, nullptr) || Read != Data.size()) {
+    return nullptr;
+  }
+
+  const auto* Dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(Data.data());
+  if (Dos->e_magic != IMAGE_DOS_SIGNATURE || Dos->e_lfanew < 0 ||
+      static_cast<size_t>(Dos->e_lfanew) + sizeof(FEX::Windows::ArchImageNtHeaders) > Data.size()) {
+    return nullptr;
+  }
+  const auto* Nt = reinterpret_cast<const FEX::Windows::ArchImageNtHeaders*>(Data.data() + Dos->e_lfanew);
+  if (Nt->Signature != IMAGE_NT_SIGNATURE || Nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR32_MAGIC) {
+    return nullptr;
+  }
+  const uint64_t ImageBase = Nt->OptionalHeader.ImageBase;
+  const uint64_t SizeOfImage = Nt->OptionalHeader.SizeOfImage;
+  if (!ImageBase || ImageBase + SizeOfImage > IosGuestWindow::Size || Nt->OptionalHeader.SizeOfHeaders > Data.size()) {
+    return nullptr;
+  }
+
+  auto* Image = static_cast<uint8_t*>(
+    VirtualAlloc(reinterpret_cast<void*>(IosGuestWindow::Base + ImageBase), SizeOfImage, MEM_COMMIT, PAGE_READWRITE));
+  if (!Image) {
+    LogMan::Msg::EFmt("Guest range {:#x}+{:#x} for {} is taken", ImageBase, SizeOfImage, Filename);
+    return nullptr;
+  }
+  memcpy(Image, Data.data(), Nt->OptionalHeader.SizeOfHeaders);
+
+  const auto* Section = IMAGE_FIRST_SECTION(Nt);
+  for (WORD i = 0; i < Nt->FileHeader.NumberOfSections; ++i, ++Section) {
+    const uint64_t Raw = Section->SizeOfRawData;
+    const uint64_t Virtual = Section->Misc.VirtualSize ? Section->Misc.VirtualSize : Raw;
+    const uint64_t Copy = std::min(Raw, Virtual);
+    if (Section->VirtualAddress + Virtual > SizeOfImage || Section->PointerToRawData + Copy > Data.size()) {
+      VirtualFree(Image, 0, MEM_DECOMMIT);
+      return nullptr;
+    }
+    memcpy(Image + Section->VirtualAddress, Data.data() + Section->PointerToRawData, Copy);
+  }
+
+  return Image;
+}
+#endif
