+// arm64 frintn/frintm/frintp/frintz/frinti: round to an integral value, kept as a float.
+template<typename F>
+inline F RoundTo(F f, RoundMode Mode) {
+  switch (Mode) {
+  case RoundMode::Nearest: return __builtin_roundeven(f);
+  case RoundMode::NegInfinity: return std::floor(f);
+  case RoundMode::PosInfinity: return std::ceil(f);
+  case RoundMode::TowardsZero: return std::trunc(f);
+  case RoundMode::Host: return std::nearbyint(f);
+  }
+  return f;
+}
+
+// arm64 sqxtn (OP_VSQXTN), sqxtun (OP_VSQXTUN) and shrn (OP_VUSHRNI): the wide elements of the
+// first InBytes bytes of A narrowed to ES bytes each, into InBytes / 2 bytes at Out.
+inline void Narrow(IROps Op, const Val& A, unsigned ES, unsigned InBytes, unsigned Shift, uint8_t* Out) {
+  const unsigned WS = ES * 2;
+  const unsigned Bits = ES * 8;
+  const int64_t SMax = static_cast<int64_t>((1ULL << (Bits - 1)) - 1);
+  const int64_t SMin = -SMax - 1;
+  const int64_t UMax = static_cast<int64_t>(Bits == 32 ? 0xffffffffULL : (1ULL << Bits) - 1);
+  for (unsigned i = 0; i < InBytes / WS; ++i) {
+    uint64_t w = 0;
+    memcpy(&w, A.B + i * WS, WS);
+    uint64_t r;
+    if (Op == OP_VUSHRNI) {
+      r = Shift >= 64 ? 0 : w >> Shift;
+    } else {
+      const unsigned Ext = 64 - WS * 8;
+      const int64_t s = static_cast<int64_t>(w << Ext) >> Ext;
+      r = static_cast<uint64_t>(Op == OP_VSQXTN ? std::clamp(s, SMin, SMax) : std::clamp<int64_t>(s, 0, UMax));
+    }
+    memcpy(Out + i * ES, &r, ES);
+  }
+}
