+void ImageTracker::RevalidateLoadedCaches(FEXCore::Core::InternalThreadState* Thread, uint64_t Address, uint64_t Size) {
+  const uint64_t GuestBase = Guest32Base();
+  if (Address < GuestBase) {
+    return;
+  }
+  const uint64_t Begin = Address - GuestBase;
+  const uint64_t End = Begin + Size;
+
+  struct RangeCheck {
+    const LoadedCache* Loaded;
+    uint64_t GuestBase;
+  };
+  auto PageReadable = [](void* Ctx, uint64_t GuestPage) {
+    return IsReadablePage(static_cast<const RangeCheck*>(Ctx)->GuestBase + GuestPage);
+  };
+  auto RangeUnchanged = [](void* Ctx, uint64_t GuestBegin, uint64_t GuestEnd) {
+    const auto* Check = static_cast<const RangeCheck*>(Ctx);
+    const uint64_t Begin = GuestBegin & ~(CodeChunkSize - 1);
+    const uint64_t End = FEXCore::AlignUp(GuestEnd, CodeChunkSize);
+    auto Section = std::ranges::find_if(Check->Loaded->CodeHashes, [&](const auto& S) { return S.GuestBegin <= Begin && End <= S.GuestEnd; });
+    if (Section == Check->Loaded->CodeHashes.end()) {
+      return false;
+    }
+    for (uint64_t Page = Begin & FEXCore::Utils::FEX_PAGE_MASK; Page < End; Page += FEXCore::Utils::FEX_PAGE_SIZE) {
+      if (!IsReadablePage(Check->GuestBase + Page)) {
+        return false;
+      }
+    }
+    for (uint64_t Chunk = Begin; Chunk < End; Chunk += CodeChunkSize) {
+      if (HashChunk(Check->GuestBase + Chunk) != Section->Chunks[(Chunk - Section->GuestBegin) / CodeChunkSize]) {
+        return false;
+      }
+    }
+    return true;
+  };
+
+  std::scoped_lock Lk {LoadedCachesLock};
+  for (auto& Loaded : LoadedCaches) {
+    if (!Loaded.Enabled || !Loaded.Image || End <= Loaded.GuestBegin || Begin >= Loaded.GuestEnd) {
+      continue;
+    }
+    RangeCheck Check {&Loaded, GuestBase};
+    const FEXCore::AbstractCodeCache::LoadedBlockFilter Filter {std::max(Begin, Loaded.GuestBegin), std::min(End, Loaded.GuestEnd),
+                                                                RangeUnchanged, PageReadable, &Check};
+    size_t Changed = 0;
+    for (uint64_t Page = Filter.Begin; Page < Filter.End; Page += FEXCore::Utils::FEX_PAGE_SIZE) {
+      if (std::ranges::any_of(Loaded.CodeHashes, [Page](const auto& S) { return S.GuestBegin <= Page && Page < S.GuestEnd; }) &&
+          !RangeUnchanged(&Check, Page, Page + FEXCore::Utils::FEX_PAGE_SIZE)) {
+        Changed++;
+      }
+    }
+    const FEXCore::ExecutableFileSectionInfo Section {Loaded.Image->Info, Loaded.GuestBegin, Loaded.GuestBegin, Loaded.GuestEnd};
+    const size_t Registered = CTX.GetCodeCache().EnableLoadedBlocks(Thread, *Loaded.Cache, Section, Filter);
+    static std::atomic<uint32_t> Reports {0};
+    if ((Registered || Changed) && Reports.fetch_add(1, std::memory_order_relaxed) < 64) {
+      LogMan::Msg::EFmt("[aot-cache] {} blocks of {} registered again after a protection change at guest {:#x}-{:#x}; "
+                        "{} of its code pages there changed since the image was mapped",
+                        Registered, Loaded.Image->Info.Filename, Filter.Begin, Filter.End, Changed);
+    }
+  }
+}
