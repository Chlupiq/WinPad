+constexpr uint64_t CodeChunkSize = 64;
+
+static uint32_t HashChunk(uint64_t HostAddress) {
+  return static_cast<uint32_t>(XXH3_64bits(reinterpret_cast<const void*>(HostAddress), CodeChunkSize));
+}
+
+// WinPad: hashes of each 64 bytes of an image's executable sections, as mapped. Address is the
+// image's host address, GuestBase what is subtracted to get guest addresses.
+static auto HashCodeSections(uint64_t Address, uint64_t Size, uint64_t GuestBase) {
+  fextl::vector<ImageTracker::CodeSectionHashes> Sections;
+  auto* Nt = RtlImageNtHeader(reinterpret_cast<HMODULE>(Address));
+  if (!Nt) {
+    return Sections;
+  }
+  auto* First = IMAGE_FIRST_SECTION(Nt);
+  for (auto* Section = First; Section != First + Nt->FileHeader.NumberOfSections; Section++) {
+    if (!(Section->Characteristics & IMAGE_SCN_MEM_EXECUTE)) {
+      continue;
+    }
+    const uint64_t Begin = Section->VirtualAddress & ~(CodeChunkSize - 1);
+    const uint64_t End = FEXCore::AlignUp(std::min<uint64_t>(Section->VirtualAddress + Section->Misc.VirtualSize, Size), CodeChunkSize);
+    if (Begin >= End) {
+      continue;
+    }
+    auto& Hashes = Sections.emplace_back();
+    Hashes.GuestBegin = Address - GuestBase + Begin;
+    Hashes.GuestEnd = Address - GuestBase + End;
+    Hashes.Chunks.reserve((End - Begin) / CodeChunkSize);
+    for (uint64_t Offset = Begin; Offset < End; Offset += CodeChunkSize) {
+      Hashes.Chunks.push_back(HashChunk(Address + Offset));
+    }
+  }
+  return Sections;
+}
