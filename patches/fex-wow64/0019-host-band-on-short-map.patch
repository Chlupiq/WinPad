 static void
 ios_fex_band_select(ios_valloc2_t valloc2) {
 	/* MADEIRA ml1600/ml1630: in the WOW64 (32-bit guest) build, cand[1] is
@@ -1170,6 +1284,12 @@ ios_fex_band_select(ios_valloc2_t valloc2) {
 		}
 	}
 
