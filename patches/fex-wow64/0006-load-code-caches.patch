+#ifdef FEX_IOS_HOST
+// WinPad: the cache FEX's offline compiler made for this image, `<cache dir>cache\<ID>-<config id>`
+// (the name the Linux frontend loads, config id 0). The whole file goes into executable JIT-pool
+// memory: on Windows FEXCore runs the cached code where the file was loaded and applies its
+// relocations there (through the pool's RW alias, see FinalizeCodePages).
+void ImageTracker::LoadImageCache(const MappedImageInfo& Image, std::string_view ID, uint64_t Address, uint64_t Size) {
+  const auto AnsiPath = fmt::format("\\??\\{}cache\\{}-{:016x}", FEX::Config::GetCacheDirectory(), ID, 0);
+  ScopedUnicodeString NtPath(AnsiPath.c_str());
+
+  OBJECT_ATTRIBUTES Attr;
+  InitializeObjectAttributes(&Attr, &*NtPath, OBJ_CASE_INSENSITIVE, NULL, NULL);
+  ScopedHandle File;
+  IO_STATUS_BLOCK IOSB;
+  if (!NT_SUCCESS(NtOpenFile(&*File, GENERIC_READ | SYNCHRONIZE, &Attr, &IOSB, FILE_SHARE_READ, FILE_SYNCHRONOUS_IO_NONALERT))) {
+    return;
+  }
+
+  FILE_STANDARD_INFORMATION StandardInfo;
+  if (!NT_SUCCESS(NtQueryInformationFile(*File, &IOSB, &StandardInfo, sizeof(StandardInfo), FileStandardInformation)) ||
+      StandardInfo.EndOfFile.QuadPart <= 0) {
+    LogMan::Msg::EFmt("[aot-cache] {}: unreadable", AnsiPath);
+    return;
+  }
+  const size_t FileSize = static_cast<size_t>(StandardInfo.EndOfFile.QuadPart);
+  const size_t AllocSize = FEXCore::AlignUp(FileSize, FEXCore::Utils::FEX_PAGE_SIZE);
+
+  auto* RX = static_cast<std::byte*>(FEXCore::Allocator::VirtualAlloc(AllocSize, true));
+  if (!RX) {
+    LogMan::Msg::EFmt("[aot-cache] {}: no JIT-pool memory for {} bytes", AnsiPath, AllocSize);
+    return;
+  }
+  auto* RW = RX + FEXCore::DualMap::WriteOffset;
+  LARGE_INTEGER Offset {};
+  if (!NT_SUCCESS(NtReadFile(*File, nullptr, nullptr, nullptr, &IOSB, RW, static_cast<ULONG>(FileSize), &Offset, nullptr)) ||
+      IOSB.Information != FileSize) {
+    LogMan::Msg::EFmt("[aot-cache] {}: short read", AnsiPath);
+    FEXCore::Allocator::VirtualFree(RX, AllocSize);
+    return;
+  }
+
+  const uint64_t GuestBase = Guest32Base();
+  auto Cache = CTX.GetCodeCache().LoadCache(std::span {RX, FileSize}, Image.Info, Address - GuestBase);
+  if (!Cache) {
+    LogMan::Msg::EFmt("[aot-cache] {}: rejected by FEXCore", AnsiPath);
+    FEXCore::Allocator::VirtualFree(RX, AllocSize);
+    return;
+  }
+  CTX.GetCodeCache().RegisterMappedCodeBuffer(*Cache);
+  LogMan::Msg::EFmt("[aot-cache] loaded {} ({} bytes) for guest {:#x}", AnsiPath, FileSize, Address - GuestBase);
+
+  std::scoped_lock Lk {LoadedCachesLock};
+  LoadedCaches.push_back({std::move(Cache), &Image, Address - GuestBase, Address - GuestBase + Size, false});
+}
+
+void ImageTracker::EnableLoadedCaches(FEXCore::Core::InternalThreadState* Thread) {
+  std::scoped_lock Lk {LoadedCachesLock};
+  for (auto& Loaded : LoadedCaches) {
+    if (Loaded.Enabled) {
+      continue;
+    }
+    Loaded.Enabled = true;
+    const FEXCore::ExecutableFileSectionInfo Section {Loaded.Image->Info, Loaded.GuestBegin, Loaded.GuestBegin, Loaded.GuestEnd};
+    CTX.GetCodeCache().EnableLoadedSection(Thread, *Loaded.Cache, Section);
+    LogMan::Msg::EFmt("[aot-cache] enabled {} at guest {:#x}", Loaded.Image->Info.Filename, Loaded.GuestBegin);
+  }
+}
+#endif
