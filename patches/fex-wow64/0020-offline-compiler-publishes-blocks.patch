+      LogMan::Msg::EFmt("[aot-gen] {:#x}: emission locks look held while generating a cache; compiled and published as usual", GuestRIP);
+    }
+    IosUnpublished = false;
+  }
   std::shared_lock<std::remove_reference_t<decltype(CodeInvalidationMutex)>> lk;
