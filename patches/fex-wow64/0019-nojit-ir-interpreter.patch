+// SPDX-License-Identifier: MIT
+// WinPad: a NoJIT fallback that runs a guest block by interpreting FEX's IR for it.
+#pragma once
+
+#include <FEXCore/fextl/vector.h>
+
+#include <cstddef>
+#include <cstdint>
+
+namespace FEXCore::Context {
+class ContextImpl;
+}
+namespace FEXCore::Core {
+struct CpuStateFrame;
+}
+namespace FEXCore::IR {
+class IRListView;
+}
+
+namespace FEXCore::CPU {
+
+// A private copy of one block's IR. The OpDispatcher's buffer is reused by the next block
+// generated on the thread, and a syscall in the interpreted block can run nested guest code
+// that does exactly that, so the interpreter never executes from the shared buffer.
+struct InterpreterIR {
+  fextl::vector<uint64_t> Data;
+  fextl::vector<uint64_t> List;
+  size_t DataSize {};
+  size_t ListSize {};
+};
+
+// Returns the name of the first IR op the interpreter cannot run, or nullptr when it can run all of them.
+// Every unsupported op in the block is logged with the guest address.
+const char* InterpreterFindUnsupported(const InterpreterIR& IR, uint64_t GuestRIP);
+
+// Diagnostics (FEX_INTERP_SURVEY=1 in the offline compiler): counts the blocks the interpreter
+// could run and the ops it lacks; the totals go to stderr when the process exits.
+void InterpreterSurvey(const InterpreterIR& IR, uint64_t GuestRIP);
+
+// Runs the block that starts at Entry against Frame->State, which holds the whole guest state
+// (the dispatcher spilled the static registers before calling the compiler). Returns the host
+// address the dispatcher jumps to next: the dispatcher loop top, or a guest signal stub.
+uintptr_t InterpretIR(Context::ContextImpl* CTX, Core::CpuStateFrame* Frame, const InterpreterIR& IR, uint64_t Entry);
+
+} // namespace FEXCore::CPU
