+// SPDX-License-Identifier: MIT
+/*
+ * WinPad: IR interpreter for the NoJIT mode.
+ *
+ * Under FEX_NOJIT=1 FEX runs only code from the AOT image and never maps executable memory. A
+ * guest block that is not in the image used to stop the process. Instead, CompileBlock now hands
+ * the block's IR to this interpreter: the frontend and the OpcodeDispatcher run as usual (they
+ * only produce data), the register allocator is skipped, and the pre-RA IR is executed here
+ * against Frame->State.
+ *
+ * Contract with the dispatcher: the dispatcher calls CompileBlock with the static registers
+ * spilled to Frame->State (GPRs to gregs, FPRs to xmm.sse, NZCV to flags[24], PF/AF to
+ * pf_raw/af_raw), and refills them from there before it jumps to what CompileBlock returned. So
+ * State is the complete guest state while the interpreter runs, and returning the dispatcher
+ * loop top with State.rip set makes the dispatcher continue at the next guest block.
+ *
+ * Semantics follow the arm64 JIT op by op (the files in Core/JIT), including how sizes below 32 bits
+ * are widened and which flags each op writes, so that IR the frontend emitted for the JIT means
+ * the same thing here. Ops the interpreter does not know are found before anything runs; the
+ * block is then refused with a log line naming each one.
+ */
+#include "Interface/Core/Interpreter/IRInterpreter.h"
+
+#include "Interface/Context/Context.h"
+#include "Interface/IR/IntrusiveIRList.h"
+#include "Interface/IR/RegisterAllocationData.h"
+#include "Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h"
+
+#include <FEXCore/Core/CoreState.h>
+#include <FEXCore/Core/X86Enums.h>
+#include <FEXCore/HLE/SyscallHandler.h>
+#include <FEXCore/IR/IR.h>
+#include <FEXCore/Utils/LogManager.h>
+
+#include <atomic>
+#include <bit>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <mutex>
+#include <type_traits>
+
+namespace FEXCore::CPU {
+namespace {
+
+using namespace FEXCore::IR;
+
+struct alignas(16) Val {
+  uint8_t B[32];
+};
+
+template<typename T>
+inline T GetEl(const Val& V, size_t i) {
+  T t;
+  memcpy(&t, V.B + i * sizeof(T), sizeof(T));
+  return t;
+}
+
+template<typename T>
+inline void SetEl(Val& V, size_t i, T t) {
+  memcpy(V.B + i * sizeof(T), &t, sizeof(T));
+}
+
+inline uint64_t Mask(unsigned Bytes) {
+  return Bytes >= 8 ? ~0ULL : ((1ULL << (Bytes * 8)) - 1);
+}
+
+// The JIT's ConvertSize: an op narrower than 64 bits is a 32-bit arm64 instruction, which
+// zero-extends its result from 32 bits.
+inline uint64_t ResW(bool Is64, uint64_t V) {
+  return Is64 ? V : static_cast<uint32_t>(V);
+}
+
+constexpr uint32_t FLAG_N = 1U << 31;
+constexpr uint32_t FLAG_Z = 1U << 30;
+constexpr uint32_t FLAG_C = 1U << 29;
+constexpr uint32_t FLAG_V = 1U << 28;
+
+inline uint32_t PackNZCV(bool N, bool Z, bool C, bool V) {
+  return (N ? FLAG_N : 0) | (Z ? FLAG_Z : 0) | (C ? FLAG_C : 0) | (V ? FLAG_V : 0);
+}
+
+// arm64 AddWithCarry at 32 or 64 bits.
+inline uint64_t AddWithCarry(uint64_t X, uint64_t Y, bool Carry, bool Is64, uint32_t* NZCV) {
+  if (Is64) {
+    const unsigned __int128 US = static_cast<unsigned __int128>(X) + Y + (Carry ? 1 : 0);
+    const uint64_t R = static_cast<uint64_t>(US);
+    const bool C = (US >> 64) != 0;
+    const bool V = ((~(X ^ Y) & (X ^ R)) >> 63) & 1;
+    *NZCV = PackNZCV(R >> 63, R == 0, C, V);
+    return R;
+  }
+  const uint32_t x = static_cast<uint32_t>(X);
+  const uint32_t y = static_cast<uint32_t>(Y);
+  const uint64_t US = static_cast<uint64_t>(x) + y + (Carry ? 1 : 0);
+  const uint32_t R = static_cast<uint32_t>(US);
+  const bool C = (US >> 32) != 0;
+  const bool V = ((~(x ^ y) & (x ^ R)) >> 31) & 1;
+  *NZCV = PackNZCV(R >> 31, R == 0, C, V);
+  return R;
+}
+
+inline bool CondHolds(CondClass Cond, uint32_t NZCV) {
+  const bool N = NZCV & FLAG_N;
+  const bool Z = NZCV & FLAG_Z;
+  const bool C = NZCV & FLAG_C;
+  const bool V = NZCV & FLAG_V;
+  switch (Cond) {
+  case CondClass::EQ: return Z;
+  case CondClass::NEQ: return !Z;
+  case CondClass::UGE: return C;
+  case CondClass::ULT: return !C;
+  case CondClass::MI: return N;
+  case CondClass::PL: return !N;
+  case CondClass::VS:
+  case CondClass::FU: return V;
+  case CondClass::VC:
+  case CondClass::FNU: return !V;
+  case CondClass::UGT: return C && !Z;
+  case CondClass::ULE: return !(C && !Z);
+  case CondClass::SGE:
+  case CondClass::FGE: return N == V;
+  case CondClass::SLT:
+  case CondClass::FLU: return N != V;
+  case CondClass::SGT:
+  case CondClass::FGT: return !Z && N == V;
+  case CondClass::SLE:
+  case CondClass::FLEU: return !(!Z && N == V);
+  case CondClass::AL: return true;
+  default: ERROR_AND_DIE_FMT("[interp] unhandled condition {}", static_cast<uint32_t>(Cond));
+  }
+}
+
+template<typename F>
+inline uint32_t FCmpNZCV(F A, F B) {
+  if (std::isnan(A) || std::isnan(B)) {
+    return FLAG_C | FLAG_V;
+  }
+  if (A == B) {
+    return FLAG_Z | FLAG_C;
+  }
+  if (A < B) {
+    return FLAG_N;
+  }
+  return FLAG_C;
+}
+
+inline uint64_t ShiftBy(ShiftType Type, uint64_t V, unsigned Amount, bool Is64) {
+  const unsigned Bits = Is64 ? 64 : 32;
+  Amount &= Bits - 1;
+  V = ResW(Is64, V);
+  switch (Type) {
+  case ShiftType::LSL: return ResW(Is64, V << Amount);
+  case ShiftType::LSR: return V >> Amount;
+  case ShiftType::ASR:
+    return Is64 ? static_cast<uint64_t>(static_cast<int64_t>(V) >> Amount) :
+                  static_cast<uint32_t>(static_cast<int32_t>(static_cast<uint32_t>(V)) >> Amount);
+  case ShiftType::ROR:
+    if (Amount == 0) {
+      return V;
+    }
+    return ResW(Is64, (V >> Amount) | (V << (Bits - Amount)));
+  }
+  return V;
+}
+
+template<typename I, typename F>
+inline I SatCvt(F f) {
+  if (std::isnan(f)) {
+    return 0;
+  }
+  if (f >= static_cast<F>(std::numeric_limits<I>::max())) {
+    return std::numeric_limits<I>::max();
+  }
+  if (f <= static_cast<F>(std::numeric_limits<I>::min())) {
+    return std::numeric_limits<I>::min();
+  }
+  return static_cast<I>(f);
+}
