+        unsigned Out = 0;
+        for (unsigned i = 0; i < 64 && M; ++i) {
+          if (M & (1ULL << i)) {
+            if (In & (1ULL << i)) {
+              R |= 1ULL << Out;
+            }
+            ++Out;
+            M &= ~(1ULL << i);
+          }
+        }
+        SetG(Id, R);
+        break;
+      }
+      case OP_MASKGENERATEFROMBITWIDTH: {
