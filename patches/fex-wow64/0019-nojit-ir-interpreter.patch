+fextl::unique_ptr<CPU::InterpreterIR>
+ContextImpl::GenerateInterpreterIR(FEXCore::Core::InternalThreadState* Thread, uint64_t GuestRIP, bool Publish) {
+  Thread->PassManager->SkipRA = true;
+  auto Result = GenerateIR(Thread, GuestRIP, false, 0);
+  Thread->PassManager->SkipRA = false;
+  FEX_MadeiraIRCapClear();
+  if (!Result.IRView) {
+    // OpDispatcher IR already released in this case.
+    return {};
+  }
+
+  auto Copy = fextl::make_unique<CPU::InterpreterIR>();
+  const auto& View = *Result.IRView;
+  Copy->DataSize = View.GetDataSize();
+  Copy->ListSize = View.GetListSize();
+  Copy->Data.resize((Copy->DataSize + 7) / 8);
+  Copy->List.resize((Copy->ListSize + 7) / 8);
+  memcpy(Copy->Data.data(), reinterpret_cast<const void*>(View.GetData()), Copy->DataSize);
+  memcpy(Copy->List.data(), reinterpret_cast<const void*>(View.GetListData()), Copy->ListSize);
+  Thread->OpDispatcher->DelayedDisownBuffer();
+
+  if (Publish) {
+    bool New;
+    size_t Count;
+    {
+      std::scoped_lock lk(InterpLearnedLock);
+      New = InterpLearned.insert(GuestRIP).second;
+      Count = InterpLearned.size();
+    }
+    if (New) {
+      if (Count <= 64) {
+        LogMan::Msg::EFmt("[interp] learned block {:#x}: not in the AOT image, interpreted", GuestRIP);
+      }
+      if (CodeMapWriter) {
+        auto Region = SyscallHandler->LookupExecutableFileSection(Thread, GuestRIP);
+        if (Region && Region->FileStartVA != 0) {
+          CodeMapWriter->AppendBlock(*Region, GuestRIP);
+        }
+      }
+    }
+  }
+  return Copy;
+}
