+class Interpreter {
+public:
+  Interpreter(Context::ContextImpl* CTX, Core::CpuStateFrame* Frame, const InterpreterIR& Copy, uint64_t Entry)
+    : CTX {CTX}
+    , Frame {Frame}
+    , IR(reinterpret_cast<void*>(const_cast<uint64_t*>(Copy.Data.data())), reinterpret_cast<void*>(const_cast<uint64_t*>(Copy.List.data())),
+         Copy.DataSize, Copy.ListSize)
+    , Entry {Entry}
+    , GuestBase {CTX->GetGuestBase()} {
+    Vals.resize(IR.GetSSACount() + 1);
+  }
+
+  uintptr_t Run();
+
+private:
+  Context::ContextImpl* CTX;
+  Core::CpuStateFrame* Frame;
+  IRListView IR;
+  uint64_t Entry;
+  uint64_t GuestBase;
+  fextl::vector<Val> Vals;
+
+  uint32_t ID(OrderedNodeWrapper W) const {
+    return W.ID().Value;
+  }
+  uint32_t ID(Ref Node) const {
+    return IR.GetID(Node).Value;
+  }
+
+  uint64_t G(OrderedNodeWrapper W) const {
+    uint64_t V;
+    memcpy(&V, Vals[ID(W)].B, 8);
+    return V;
+  }
+  const Val& VV(OrderedNodeWrapper W) const {
+    return Vals[ID(W)];
+  }
+  void SetG(uint32_t Id, uint64_t V) {
+    memcpy(Vals[Id].B, &V, 8);
+    memset(Vals[Id].B + 8, 0, 8);
+  }
+  void SetV(uint32_t Id, const Val& V) {
+    Vals[Id] = V;
+  }
+  VectorRegType X80(OrderedNodeWrapper W) const {
+    VectorRegType R;
+    memcpy(&R, Vals[ID(W)].B, sizeof(R));
+    return R;
+  }
+  void SetX80(uint32_t Id, VectorRegType R) {
+    memset(&Vals[Id], 0, sizeof(Val));
+    memcpy(Vals[Id].B, &R, sizeof(R));
+  }
+  void SetF64(uint32_t Id, double D) {
+    memset(&Vals[Id], 0, sizeof(Val));
+    memcpy(Vals[Id].B, &D, sizeof(D));
+  }
+
+  bool IsInline(OrderedNodeWrapper W) const {
+    if (W.IsInvalid()) {
+      return false;
+    }
+    const auto Op = IR.GetOp<IROp_Header>(W)->Op;
+    return Op == OP_INLINECONSTANT || Op == OP_INLINEENTRYPOINTOFFSET;
+  }
+
+  bool IsFPRNode(OrderedNodeWrapper W) const {
+    const auto* Op = IR.GetOp<IROp_Header>(W);
+    auto Class = GetRegClass(Op->Op);
+    if (Class == RegClass::Complex) {
+      switch (Op->Op) {
+      case OP_LOADREGISTER: Class = Op->C<IROp_LoadRegister>()->Class; break;
+      case OP_LOADCONTEXT: Class = Op->C<IROp_LoadContext>()->Class; break;
+      case OP_LOADCONTEXTINDEXED: Class = Op->C<IROp_LoadContextIndexed>()->Class; break;
+      case OP_LOADMEM: Class = Op->C<IROp_LoadMem>()->Class; break;
+      case OP_LOADMEMTSO: Class = Op->C<IROp_LoadMemTSO>()->Class; break;
+      default: break;
+      }
+    }
+    return Class == RegClass::FPR || Class == RegClass::FPRFixed;
+  }
+
+  uint32_t NZCV() const {
+    uint32_t V;
+    memcpy(&V, &Frame->State.flags[X86State::RFLAG_NZCV_LOC], sizeof(V));
+    return V;
+  }
+  void SetNZCV(uint32_t V) {
+    V &= 0xF000'0000U;
+    memcpy(&Frame->State.flags[X86State::RFLAG_NZCV_LOC], &V, sizeof(V));
+  }
+  // Replace only the flags in FlagMask.
+  void SetNZCVMasked(uint32_t V, uint32_t FlagMask) {
+    SetNZCV((NZCV() & ~FlagMask) | (V & FlagMask));
+  }
+
+  uint8_t* ToHost(uint64_t Guest) const {
+    if (GuestBase) {
+      return reinterpret_cast<uint8_t*>(GuestBase + static_cast<uint32_t>(Guest));
+    }
+    return reinterpret_cast<uint8_t*>(Guest);
+  }
+
+  uint8_t* MemAddr(OrderedNodeWrapper Addr, OrderedNodeWrapper Offset, MemOffsetType OffsetType, uint8_t OffsetScale, bool HostAddr) const {
+    uint64_t EA = G(Addr);
+    if (!Offset.IsInvalid()) {
+      uint64_t Off = G(Offset);
+      if (!IsInline(Offset)) {
+        switch (OffsetType) {
+        case MemOffsetType::SXTX: break;
+        case MemOffsetType::UXTW: Off = static_cast<uint32_t>(Off); break;
+        case MemOffsetType::SXTW: Off = static_cast<uint64_t>(static_cast<int64_t>(static_cast<int32_t>(Off))); break;
+        default: ERROR_AND_DIE_FMT("[interp] bad offset type {}", static_cast<uint32_t>(OffsetType));
+        }
+        Off *= OffsetScale;
+      }
+      EA += Off;
+    }
+    if (HostAddr) {
+      return reinterpret_cast<uint8_t*>(EA);
+    }
+    return ToHost(EA);
+  }
+
+  static void LoadBytes(Val& Dst, const uint8_t* Src, unsigned Size) {
+    memset(&Dst, 0, sizeof(Dst));
+    memcpy(Dst.B, Src, Size);
+  }
+
+  uint64_t AtomicOp(IROps Op, uint8_t* Ptr, unsigned Size, uint64_t Value);
+
+  uintptr_t ExitTo(uint64_t RIP) {
+    Frame->State.rip = RIP;
+    return Frame->Pointers.DispatcherLoopTop;
+  }
+};
+
+template<typename T>
+inline T AtomicApply(IROps Op, T Old, T V) {
+  switch (Op) {
+  case OP_ATOMICSWAP: return V;
+  case OP_ATOMICFETCHADD: return Old + V;
+  case OP_ATOMICFETCHSUB: return Old - V;
+  case OP_ATOMICFETCHAND: return Old & V;
+  case OP_ATOMICFETCHCLR: return Old & ~V;
+  case OP_ATOMICFETCHOR: return Old | V;
+  case OP_ATOMICFETCHXOR: return Old ^ V;
+  case OP_ATOMICFETCHNEG: return static_cast<T>(0 - Old);
+  default: return Old;
+  }
+}
+
+// Unaligned or 128-bit atomics have no single host instruction here; they are serialized
+// against each other with this lock (the JIT's own unaligned path is not atomic against plain
+// stores either).
+std::mutex SlowAtomicLock;
+
+uint64_t Interpreter::AtomicOp(IROps Op, uint8_t* Ptr, unsigned Size, uint64_t Value) {
+  uint64_t Result {};
+  FOR_ES(Size, {
+    T V = static_cast<T>(Value);
+    if ((reinterpret_cast<uintptr_t>(Ptr) & (sizeof(T) - 1)) == 0) {
+      T* P = reinterpret_cast<T*>(Ptr);
+      T Old = __atomic_load_n(P, __ATOMIC_RELAXED);
+      while (!__atomic_compare_exchange_n(P, &Old, AtomicApply<T>(Op, Old, V), true, __ATOMIC_SEQ_CST, __ATOMIC_RELAXED)) {
+      }
+      Result = Old;
+    } else {
+      std::scoped_lock lk(SlowAtomicLock);
+      T Old;
+      memcpy(&Old, Ptr, sizeof(T));
+      T New = AtomicApply<T>(Op, Old, V);
+      memcpy(Ptr, &New, sizeof(T));
+      Result = Old;
+    }
+  });
+  return Result;
+}
+
+uintptr_t Interpreter::Run() {
+  // Constants first: they are SSA values with no dependencies.
+  for (auto [Node, Op] : IR.GetAllCode()) {
+    const auto Id = ID(Node);
+    switch (Op->Op) {
+    case OP_CONSTANT: SetG(Id, Op->C<IROp_Constant>()->Constant); break;
+    case OP_INLINECONSTANT: SetG(Id, Op->C<IROp_InlineConstant>()->Constant); break;
+    case OP_ENTRYPOINTOFFSET:
+    case OP_INLINEENTRYPOINTOFFSET: {
+      const int64_t Offset =
+        Op->Op == OP_ENTRYPOINTOFFSET ? Op->C<IROp_EntrypointOffset>()->Offset : Op->C<IROp_InlineEntrypointOffset>()->Offset;
+      uint64_t V = Entry + Offset;
+      if (Op->Size == OpSize::i32Bit) {
+        V &= 0xFFFF'FFFFULL;
+      }
+      SetG(Id, V);
+      break;
+    }
+    default: break;
+    }
+  }
+
+  auto Header = IR.GetHeader();
+  Ref Block = IR.GetNode(Header->Blocks);
+
+  for (;;) {
+    Ref NextBlock = nullptr;
+
+    for (auto [CodeNode, IROp] : IR.GetCode(Block)) {
+      const uint32_t Id = ID(CodeNode);
+      const unsigned SZ = OpSizeToSize(IROp->Size);
+      const bool Is64 = IROp->Size == OpSize::i64Bit;
+      const unsigned ES = OpSizeToSize(IROp->ElementSize);
+
+      switch (IROp->Op) {
+      case OP_DUMMY:
+      case OP_IRHEADER:
+      case OP_CODEBLOCK:
+      case OP_BEGINBLOCK:
+      case OP_ENDBLOCK:
+      case OP_INVALIDATEFLAGS:
+      case OP_GUESTOPCODE:
+      case OP_CONSTANT:
+      case OP_INLINECONSTANT:
+      case OP_ENTRYPOINTOFFSET:
+      case OP_INLINEENTRYPOINTOFFSET:
+      case OP_YIELD:
+      case OP_CACHELINECLEAR:
+      case OP_CACHELINECLEAN:
+      case OP_PREFETCH:
+      case OP_TELEMETRYSETVALUE: break;
+
+      case OP_ALLOCATEGPR:
+      case OP_ALLOCATEFPR:
+      case OP_ALLOCATEGPRAFTER: memset(&Vals[Id], 0, sizeof(Val)); break;
+
+      case OP_COPY: SetV(Id, VV(IROp->Args[0])); break;
+      case OP_RMWHANDLE: SetV(Id, VV(IROp->Args[0])); break;
+
+      case OP_PRINT: LogMan::Msg::IFmt("[interp] Print {:#x}", G(IROp->Args[0])); break;
+      case OP_PRINTMSG: LogMan::Msg::IFmt("[interp] {}", IROp->C<IROp_PrintMsg>()->Value); break;
+
+      case OP_GETROUNDINGMODE: {
+        uint64_t FPCR = 0;
+#if defined(__aarch64__) || defined(_M_ARM64)
+        __asm__ volatile("mrs %0, fpcr" : "=r"(FPCR));
+#endif
+        uint64_t Dst = (FPCR >> 22) & 7;
+        const uint32_t Rev = __builtin_bitreverse32(static_cast<uint32_t>(Dst));
+        Dst = (Dst & ~3ULL) | ((Rev >> 30) & 3);
+        SetG(Id, Dst);
+        break;
+      }
+      case OP_SETROUNDINGMODE: {
+        auto Op = IROp->C<IROp_SetRoundingMode>();
+        const uint64_t Src = G(Op->RoundMode);
+        uint64_t FPCR = 0;
+#if defined(__aarch64__) || defined(_M_ARM64)
+        __asm__ volatile("mrs %0, fpcr" : "=r"(FPCR));
+#endif
+        const uint64_t Round = __builtin_bitreverse32(static_cast<uint32_t>(Src)) >> 30;
+        FPCR = (FPCR & ~(3ULL << 22)) | (Round << 22);
+        FPCR = (FPCR & ~(1ULL << 24)) | (((Src >> 2) & 1) << 24);
+        if (Op->SetDAZ && CTX->HostFeatures.SupportsAFP) {
+          FPCR = (FPCR & ~1ULL) | ((G(Op->MXCSR) >> 6) & 1);
+        }
+#if defined(__aarch64__) || defined(_M_ARM64)
+        __asm__ volatile("msr fpcr, %0" : : "r"(FPCR));
+#endif
+        break;
+      }
+      case OP_PUSHROUNDINGMODE: {
+        auto Op = IROp->C<IROp_PushRoundingMode>();
+        uint64_t FPCR = 0;
+#if defined(__aarch64__) || defined(_M_ARM64)
+        __asm__ volatile("mrs %0, fpcr" : "=r"(FPCR));
+#endif
+        SetG(Id, FPCR);
+        uint64_t New = FPCR;
+        if (Op->RoundMode == 3) {
+          New |= 3ULL << 22;
+        } else if (Op->RoundMode == 0) {
+          New &= ~(3ULL << 22);
+        } else {
+          New &= ~(static_cast<uint64_t>(Op->RoundMode) << 22);
+          New |= static_cast<uint64_t>(Op->RoundMode == 2 ? 1 : 2) << 22;
+        }
+#if defined(__aarch64__) || defined(_M_ARM64)
+        __asm__ volatile("msr fpcr, %0" : : "r"(New));
+#endif
+        break;
+      }
+      case OP_POPROUNDINGMODE: {
+        [[maybe_unused]] const uint64_t FPCR = G(IROp->C<IROp_PopRoundingMode>()->FPCR);
+#if defined(__aarch64__) || defined(_M_ARM64)
+        __asm__ volatile("msr fpcr, %0" : : "r"(FPCR));
+#endif
+        break;
+      }
+      case OP_CYCLECOUNTER: {
+        uint64_t V = 0;
+#if defined(__aarch64__) || defined(_M_ARM64)
+        __asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(V));
+#endif
+        SetG(Id, V);
+        break;
+      }
+      case OP_PROCESSORID: SetG(Id, 0); break;
+
+      // ---- Control flow ----
+      case OP_JUMP: NextBlock = IR.GetNode(IROp->C<IROp_Jump>()->TargetBlock); break;
+      case OP_CONDJUMP: {
+        auto Op = IROp->C<IROp_CondJump>();
+        bool Taken;
+        if (Op->FromNZCV) {
+          Taken = CondHolds(Op->Cond, NZCV());
+        } else {
+          const uint64_t A = G(Op->Cmp1);
+          const uint64_t B = G(Op->Cmp2);
+          const bool Cmp64 = Op->CompareSize != OpSize::i32Bit;
+          if (Op->Cond == CondClass::TSTZ) {
+            Taken = ((A >> (B & 63)) & 1) == 0;
+          } else if (Op->Cond == CondClass::TSTNZ) {
+            Taken = ((A >> (B & 63)) & 1) != 0;
+          } else {
+            uint32_t Flags;
+            AddWithCarry(A, ~B, true, Cmp64, &Flags);
+            Taken = CondHolds(Op->Cond, Flags);
+          }
+        }
+        NextBlock = IR.GetNode(Taken ? Op->TrueBlock : Op->FalseBlock);
+        break;
+      }
+      case OP_EXITFUNCTION: return ExitTo(G(IROp->C<IROp_ExitFunction>()->NewRIP));
+      case OP_BREAK: {
+        auto Op = IROp->C<IROp_Break>();
+        Core::CpuStateFrame::SynchronousFaultDataStruct State = {
+          .FaultToTopAndGeneratedException = 1,
+          .Signal = Op->Reason.Signal,
+          .TrapNo = Op->Reason.TrapNumber,
+          .si_code = Op->Reason.si_code,
+          .err_code = Op->Reason.ErrorRegister,
+        };
+        Frame->SynchronousFaultData = State;
+        switch (Op->Reason.Signal) {
+        case Core::FAULT_SIGILL: return Frame->Pointers.GuestSignal_SIGILL;
+        case Core::FAULT_SIGSEGV: return Frame->Pointers.GuestSignal_SIGSEGV;
+        case Core::FAULT_SIGTRAP:
+        default: return Frame->Pointers.GuestSignal_SIGTRAP;
+        }
+      }
+      case OP_SYSCALL: {
+        FEXCore::HLE::SyscallArguments Args {};
+        for (uint32_t i = 0; i < FEXCore::HLE::SyscallArguments::MAX_ARGS; ++i) {
+          if (!IROp->Args[i].IsInvalid()) {
+            Args.Argument[i] = G(IROp->Args[i]);
+          }
+        }
+        Frame->InSyscallInfo = 0xFFFF;
+        const uint64_t Ret = CTX->SyscallHandler->HandleSyscall(Frame, &Args);
+        Frame->InSyscallInfo = 0;
+        if (CTX->SyscallHandler->GetOSABI() != FEXCore::HLE::SyscallOSABI::OS_GENERIC) {
+          SetG(Id, Ret);
+        }
+        break;
+      }
+      case OP_CPUID: {
+        auto Op = IROp->C<IROp_CPUID>();
+        const auto R = CTX->CPUID.RunFunction(static_cast<uint32_t>(G(Op->Function)), static_cast<uint32_t>(G(Op->Leaf)));
+        SetG(ID(Op->OutEAX), R.eax);
+        SetG(ID(Op->OutEBX), R.ebx);
+        SetG(ID(Op->OutECX), R.ecx);
+        SetG(ID(Op->OutEDX), R.edx);
+        break;
+      }
+      case OP_XGETBV: {
+        auto Op = IROp->C<IROp_XGetBV>();
+        const auto R = CTX->CPUID.RunXCRFunction(static_cast<uint32_t>(G(Op->Function)));
+        SetG(ID(Op->OutEAX), R.eax);
+        SetG(ID(Op->OutEDX), R.edx);
+        break;
+      }
+
+      // ---- Static registers and context ----
+      case OP_LOADREGISTER: {
+        auto Op = IROp->C<IROp_LoadRegister>();
+        if (Op->Class == RegClass::GPR) {
+          SetG(Id, Frame->State.gregs[Op->Reg]);
+        } else {
+          Val V {};
+          memcpy(V.B, Frame->State.xmm.sse.data[Op->Reg], 16);
+          SetV(Id, V);
+        }
+        break;
+      }
+      case OP_STOREREGISTER: {
+        auto Op = IROp->C<IROp_StoreRegister>();
+        const PhysicalRegister Reg(CodeNode);
+        if (Reg.AsRegClass() == RegClass::GPRFixed) {
+          Frame->State.gregs[Reg.Reg] = G(Op->Value);
+        } else if (Reg.AsRegClass() == RegClass::FPRFixed) {
+          memcpy(Frame->State.xmm.sse.data[Reg.Reg], VV(Op->Value).B, 16);
+        } else {
+          ERROR_AND_DIE_FMT("[interp] StoreRegister without a fixed register (class {})", static_cast<uint32_t>(Reg.Class));
+        }
+        SetV(Id, VV(Op->Value));
+        break;
+      }
+      case OP_LOADPF: SetG(Id, Frame->State.pf_raw); break;
+      case OP_LOADAF: SetG(Id, Frame->State.af_raw); break;
+      case OP_STOREPF: Frame->State.pf_raw = static_cast<uint32_t>(G(IROp->Args[0])); break;
