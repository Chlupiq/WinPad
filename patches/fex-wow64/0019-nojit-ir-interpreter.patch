+#define FOR_ES(ES, BODY)                          \
+  switch (ES) {                                   \
+  case 1: {                                       \
+    using T = uint8_t;                            \
+    BODY;                                         \
+    break;                                        \
+  }                                               \
+  case 2: {                                       \
+    using T = uint16_t;                           \
+    BODY;                                         \
+    break;                                        \
+  }                                               \
+  case 4: {                                       \
+    using T = uint32_t;                           \
+    BODY;                                         \
+    break;                                        \
+  }                                               \
+  case 8: {                                       \
+    using T = uint64_t;                           \
+    BODY;                                         \
+    break;                                        \
+  }                                               \
+  default: ERROR_AND_DIE_FMT("[interp] bad element size {}", ES); \
+  }
+
+#define FOR_FES(ES, BODY)                         \
+  switch (ES) {                                   \
+  case 4: {                                       \
+    using F = float;                              \
+    using T = uint32_t;                           \
+    using S [[maybe_unused]] = int32_t;           \
+    BODY;                                         \
+    break;                                        \
+  }                                               \
+  case 8: {                                       \
+    using F = double;                             \
+    using T = uint64_t;                           \
+    using S [[maybe_unused]] = int64_t;           \
+    BODY;                                         \
+    break;                                        \
+  }                                               \
+  default: ERROR_AND_DIE_FMT("[interp] bad float element size {}", ES); \
+  }
+
+template<typename F>
+inline F FBits(uint64_t V) {
+  if constexpr (sizeof(F) == 4) {
+    return std::bit_cast<float>(static_cast<uint32_t>(V));
+  } else {
+    return std::bit_cast<double>(V);
+  }
+}
+
+template<typename F>
+inline uint64_t FToBits(F f) {
+  if constexpr (sizeof(F) == 4) {
+    return std::bit_cast<uint32_t>(f);
+  } else {
+    return std::bit_cast<uint64_t>(f);
+  }
+}
