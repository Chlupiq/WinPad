+          memcpy(&a, A.B + (Upper ? N : 0) * HS + i * HS, HS);
+          memcpy(&b, B.B + (Upper ? N : 0) * HS + i * HS, HS);
+          uint64_t r;
+          if (Signed) {
+            const unsigned Shift = 64 - HS * 8;
+            r = static_cast<uint64_t>((static_cast<int64_t>(a << Shift) >> Shift) * (static_cast<int64_t>(b << Shift) >> Shift));
+          } else {
+            r = a * b;
+          }
+          memcpy(V.B + i * ES, &r, ES);
+        }
+        SetV(Id, V);
+        break;
+      }
+      case OP_VREV32:
+      case OP_VREV64: {
+        const Val& A = VV(IROp->Args[0]);
+        const unsigned Group = IROp->Op == OP_VREV32 ? 4 : 8;
+        const unsigned PerGroup = Group / ES;
+        Val V {};
+        for (unsigned g = 0; g < SZ; g += Group) {
+          for (unsigned e = 0; e < PerGroup; ++e) {
+            memcpy(V.B + g + e * ES, A.B + g + (PerGroup - 1 - e) * ES, ES);
+          }
+        }
+        SetV(Id, V);
+        break;
+      }
+      case OP_VDUPELEMENT: {
+        auto Op = IROp->C<IROp_VDupElement>();
+        const Val& A = VV(Op->Vector);
+        Val V {};
+        for (unsigned i = 0; i < SZ; i += ES) {
+          memcpy(V.B + i, A.B + Op->Index * ES, ES);
+        }
+        SetV(Id, V);
+        break;
+      }
+      case OP_VINSELEMENT: {
+        auto Op = IROp->C<IROp_VInsElement>();
+        Val V {};
+        memcpy(V.B, VV(Op->DestVector).B, SZ);
+        memcpy(V.B + Op->DestIdx * ES, VV(Op->SrcVector).B + Op->SrcIdx * ES, ES);
+        SetV(Id, V);
+        break;
+      }
+      case OP_VINSGPR: {
+        auto Op = IROp->C<IROp_VInsGPR>();
+        Val V {};
+        memcpy(V.B, VV(Op->DestVector).B, SZ);
+        const uint64_t Src = G(Op->Src);
+        memcpy(V.B + Op->DestIdx * ES, &Src, ES);
+        SetV(Id, V);
+        break;
+      }
+      case OP_VEXTRACTTOGPR: {
+        auto Op = IROp->C<IROp_VExtractToGPR>();
+        uint64_t R = 0;
+        memcpy(&R, VV(Op->Vector).B + Op->Index * SZ, SZ);
+        SetG(Id, R);
+        break;
+      }
+      case OP_VCASTFROMGPR: {
+        const uint64_t Src = G(IROp->Args[0]);
+        Val V {};
+        memcpy(V.B, &Src, ES);
+        SetV(Id, V);
+        break;
+      }
+      case OP_VDUPFROMGPR: {
+        const uint64_t Src = G(IROp->Args[0]);
+        Val V {};
+        for (unsigned i = 0; i < SZ; i += ES) {
+          memcpy(V.B + i, &Src, ES);
+        }
+        SetV(Id, V);
+        break;
+      }
+      case OP_VLOADTWOGPRS: {
+        auto Op = IROp->C<IROp_VLoadTwoGPRs>();
+        Val V {};
+        SetEl<uint64_t>(V, 0, G(Op->Lower));
+        SetEl<uint64_t>(V, 1, G(Op->Upper));
+        SetV(Id, V);
+        break;
+      }
+      case OP_VEXTR: {
+        auto Op = IROp->C<IROp_VExtr>();
+        // arm64 `ext` with the operands swapped: bytes [n, n + size) of VectorUpper:VectorLower,
+        // VectorUpper first, with zeros past both.
+        uint8_t C[96] {};
+        memcpy(C, VV(Op->VectorUpper).B, SZ);
+        memcpy(C + SZ, VV(Op->VectorLower).B, SZ);
+        const unsigned N = Op->Index * ES;
+        Val V {};
+        if (N < 2 * SZ) {
+          memcpy(V.B, C + N, SZ);
+        }
+        SetV(Id, V);
+        break;
+      }
+      case OP_VTBL1:
+      case OP_VTBL2:
+      case OP_VTBX1: {
+        uint8_t Table[32] {};
+        const Val* Indices;
+        const Val* Fallback = nullptr;
+        unsigned TableSize = 16;
+        if (IROp->Op == OP_VTBL1) {
+          auto Op = IROp->C<IROp_VTBL1>();
+          memcpy(Table, VV(Op->VectorTable).B, 16);
+          Indices = &VV(Op->VectorIndices);
+        } else if (IROp->Op == OP_VTBL2) {
+          auto Op = IROp->C<IROp_VTBL2>();
+          memcpy(Table, VV(Op->VectorTable1).B, 16);
+          memcpy(Table + 16, VV(Op->VectorTable2).B, 16);
+          TableSize = 32;
+          Indices = &VV(Op->VectorIndices);
+        } else {
+          auto Op = IROp->C<IROp_VTBX1>();
+          memcpy(Table, VV(Op->VectorTable).B, 16);
+          Indices = &VV(Op->VectorIndices);
+          Fallback = &VV(Op->VectorSrcDst);
+        }
+        Val V {};
+        for (unsigned i = 0; i < SZ; ++i) {
+          const uint8_t Idx = Indices->B[i];
+          V.B[i] = Idx < TableSize ? Table[Idx] : (Fallback ? Fallback->B[i] : 0);
+        }
+        SetV(Id, V);
+        break;
+      }
+
+      // ---- Vector float ----
+      case OP_VFADD:
+      case OP_VFSUB:
+      case OP_VFMUL:
+      case OP_VFDIV:
+      case OP_VFMIN:
+      case OP_VFMAX:
+      case OP_VFCMPEQ:
+      case OP_VFCMPNEQ:
+      case OP_VFCMPLT:
+      case OP_VFCMPGT:
+      case OP_VFCMPLE:
+      case OP_VFCMPORD:
+      case OP_VFCMPUNO: {
+        const Val& A = VV(IROp->Args[0]);
+        const Val& B = VV(IROp->Args[1]);
+        Val V {};
+        FOR_FES(ES, {
+          for (unsigned i = 0; i < SZ / ES; ++i) {
+            const F a = std::bit_cast<F>(GetEl<T>(A, i));
+            const F b = std::bit_cast<F>(GetEl<T>(B, i));
+            const T Ones = static_cast<T>(~T {0});
+            T r {};
+            switch (IROp->Op) {
+            case OP_VFADD: r = std::bit_cast<T>(a + b); break;
+            case OP_VFSUB: r = std::bit_cast<T>(a - b); break;
+            case OP_VFMUL: r = std::bit_cast<T>(a * b); break;
+            case OP_VFDIV: r = std::bit_cast<T>(a / b); break;
+            case OP_VFMIN: r = std::bit_cast<T>(a < b ? a : b); break;
+            case OP_VFMAX: r = std::bit_cast<T>(a > b ? a : b); break;
+            case OP_VFCMPEQ: r = a == b ? Ones : T {0}; break;
+            case OP_VFCMPNEQ: r = !(a == b) ? Ones : T {0}; break;
+            case OP_VFCMPLT: r = a < b ? Ones : T {0}; break;
+            case OP_VFCMPGT: r = a > b ? Ones : T {0}; break;
+            case OP_VFCMPLE: r = a <= b ? Ones : T {0}; break;
+            case OP_VFCMPORD: r = (!std::isnan(a) && !std::isnan(b)) ? Ones : T {0}; break;
+            default: r = (std::isnan(a) || std::isnan(b)) ? Ones : T {0}; break;
+            }
+            SetEl<T>(V, i, r);
+          }
+        });
+        SetV(Id, V);
+        break;
+      }
+      case OP_VFABS:
+      case OP_VFNEG:
+      case OP_VFRECP:
+      case OP_VFSQRT:
+      case OP_VFRSQRT:
+      case OP_VECTOR_STOF:
+      case OP_VECTOR_FTOS:
+      case OP_VECTOR_FTOZS: {
+        const Val& A = VV(IROp->Args[0]);
+        Val V {};
+        FOR_FES(ES, {
+          for (unsigned i = 0; i < SZ / ES; ++i) {
+            const T bits = GetEl<T>(A, i);
+            const F a = std::bit_cast<F>(bits);
+            T r {};
+            switch (IROp->Op) {
+            case OP_VFABS: r = std::bit_cast<T>(std::fabs(a)); break;
+            case OP_VFNEG: r = std::bit_cast<T>(-a); break;
+            case OP_VFRECP: r = std::bit_cast<T>(F {1} / a); break;
+            case OP_VFSQRT: r = std::bit_cast<T>(std::sqrt(a)); break;
+            case OP_VFRSQRT: r = std::bit_cast<T>(F {1} / std::sqrt(a)); break;
+            case OP_VECTOR_STOF: r = std::bit_cast<T>(static_cast<F>(static_cast<S>(bits))); break;
+            case OP_VECTOR_FTOS: r = static_cast<T>(SatCvt<S>(std::nearbyint(a))); break;
+            default: r = static_cast<T>(SatCvt<S>(a)); break;
+            }
+            SetEl<T>(V, i, r);
+          }
+        });
+        SetV(Id, V);
+        break;
+      }
+      case OP_VECTOR_FTOF: {
+        auto Op = IROp->C<IROp_Vector_FToF>();
+        const Val& A = VV(Op->Vector);
+        Val V {};
+        if (ES == 8 && Op->SrcElementSize == OpSize::i32Bit) {
+          for (unsigned i = 0; i < SZ / 8; ++i) {
+            SetEl<uint64_t>(V, i, FToBits(static_cast<double>(std::bit_cast<float>(GetEl<uint32_t>(A, i)))));
+          }
+        } else if (ES == 4 && Op->SrcElementSize == OpSize::i64Bit) {
+          for (unsigned i = 0; i < SZ / 8; ++i) {
+            SetEl<uint32_t>(V, i, static_cast<uint32_t>(FToBits(static_cast<float>(std::bit_cast<double>(GetEl<uint64_t>(A, i))))));
+          }
+        } else {
+          ERROR_AND_DIE_FMT("[interp] Vector_FToF {} <- {} unsupported", ES, OpSizeToSize(Op->SrcElementSize));
+        }
+        SetV(Id, V);
+        break;
+      }
+
+      default: ERROR_AND_DIE_FMT("[interp] op {} reached the interpreter unsupported", GetName(IROp->Op));
+      }
+
+      if (NextBlock) {
+        break;
+      }
+    }
+
+    if (!NextBlock) {
+      ERROR_AND_DIE_FMT("[interp] block of guest {:#x} ended without a branch", Entry);
+    }
+    Block = NextBlock;
+  }
+}
+
+} // namespace
+
+const char* InterpreterFindUnsupported(const InterpreterIR& Copy, uint64_t GuestRIP) {
+  IR::IRListView IR(reinterpret_cast<void*>(const_cast<uint64_t*>(Copy.Data.data())),
+                    reinterpret_cast<void*>(const_cast<uint64_t*>(Copy.List.data())), Copy.DataSize, Copy.ListSize);
+  const char* First = nullptr;
+  for (auto [Node, Op] : IR.GetAllCode()) {
+    if (!IsSupported(Op->Op)) {
+      const auto& Name = IR::GetName(Op->Op);
+      LogMan::Msg::EFmt("[interp] guest block {:#x} needs IR op {}, which the interpreter does not implement", GuestRIP, Name);
+      if (!First) {
+        First = Name.data();
+      }
+    }
+  }
+  return First;
+}
+
+namespace {
+// Totals for InterpreterSurvey, printed when the process exits.
+struct SurveyTotals {
+  std::mutex Lock;
+  uint64_t Blocks {};
+  uint64_t Runnable {};
+  uint64_t MissingBlocks[IR::IROps::OP_LAST + 1] {};
+
+  ~SurveyTotals() {
+    if (!Blocks) {
+      return;
+    }
+    fprintf(stderr, "[interp-survey] blocks: %llu, runnable by the interpreter: %llu\n", static_cast<unsigned long long>(Blocks),
+            static_cast<unsigned long long>(Runnable));
+    for (size_t i = 0; i <= IR::IROps::OP_LAST; ++i) {
+      if (MissingBlocks[i]) {
+        fprintf(stderr, "[interp-survey] %s: needed by %llu blocks\n", IR::GetName(static_cast<IR::IROps>(i)).data(),
+                static_cast<unsigned long long>(MissingBlocks[i]));
+      }
+    }
+  }
+};
+SurveyTotals Survey;
+} // namespace
+
+void InterpreterSurvey(const InterpreterIR& Copy, uint64_t GuestRIP) {
+  IR::IRListView IR(reinterpret_cast<void*>(const_cast<uint64_t*>(Copy.Data.data())),
+                    reinterpret_cast<void*>(const_cast<uint64_t*>(Copy.List.data())), Copy.DataSize, Copy.ListSize);
+  bool Seen[IR::IROps::OP_LAST + 1] {};
+  bool Runnable = true;
+  for (auto [Node, Op] : IR.GetAllCode()) {
+    if (!IsSupported(Op->Op)) {
+      Runnable = false;
+      Seen[Op->Op] = true;
+    }
+  }
+  std::scoped_lock lk(Survey.Lock);
+  ++Survey.Blocks;
+  if (Runnable) {
+    ++Survey.Runnable;
+  }
+  for (size_t i = 0; i <= IR::IROps::OP_LAST; ++i) {
+    if (Seen[i]) {
+      if (Survey.MissingBlocks[i]++ == 0) {
+        fprintf(stderr, "[interp-survey] %s first needed by block %#llx\n", IR::GetName(static_cast<IR::IROps>(i)).data(),
+                static_cast<unsigned long long>(GuestRIP));
+      }
+    }
+  }
+}
+
+uintptr_t InterpretIR(Context::ContextImpl* CTX, Core::CpuStateFrame* Frame, const InterpreterIR& IR, uint64_t Entry) {
+  Interpreter I(CTX, Frame, IR, Entry);
+  return I.Run();
+}
+
+} // namespace FEXCore::CPU
