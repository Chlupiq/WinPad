+fextl::unique_ptr<MappedCodeCacheFile> CodeCache::LoadLinkedCache(const std::byte* Meta, std::byte* Code, std::byte* Data,
+                                                                  const ExecutableFileInfo& FileInfo, uint64_t FileStartVA) {
+#if defined(FEX_IOS_HOST) && defined(_WIN32)
+  if (!EnableCodeCaching) {
+    return nullptr;
+  }
+
+  FEXCORE_PROFILE_SCOPED("LoadLinkedCache");
+
+  // Written by WinPad's tools/cache2macho: the cache file without its code, which the
+  // image holds in its signed text section, with its data area in a writable section.
+  struct {
+    char Magic[4];
+    uint32_t Version;
+    uint64_t CodeSize;
+    uint64_t DataSize;
+    uint64_t CodeOffset;
+    uint64_t CacheSize;
+  } MetaHeader;
+  static_assert(sizeof(MetaHeader) == 40);
+  ::memcpy(&MetaHeader, Meta, sizeof(MetaHeader));
+  if (::memcmp(MetaHeader.Magic, "FXAM", 4) != 0 || MetaHeader.Version != 1) {
+    LogMan::Msg::EFmt("Invalid AOT image metadata");
+    return nullptr;
+  }
+
+  auto CacheFile = std::span {const_cast<std::byte*>(Meta) + sizeof(MetaHeader), MetaHeader.CacheSize};
+  CodeCacheHeader header {};
+  std::byte* BlockListStart {};
+  std::span<const CPU::Relocation> Relocations;
+  if (ParseCacheFile(CacheFile, header, BlockListStart, Relocations) != MetaHeader.CodeOffset ||
+      header.CodeBufferSize != MetaHeader.CodeSize || MetaHeader.CodeOffset > CacheFile.size_bytes()) {
+    LogMan::Msg::EFmt("AOT image metadata does not match its cache");
+    return nullptr;
+  }
+
+  // The linker has resolved every reference from the code to the data area, so
+  // only relocations that fill the data area are allowed.
+  uint64_t NumDataSlots = 0;
+  for (const auto& Reloc : Relocations) {
+    const auto Count = CPU::AOTDataSlotCount(Reloc);
+    if (!Count) {
+      LogMan::Msg::EFmt("AOT image has a relocation into code (type {}); it needs an AOTCodeCacheWIP cache", ToUnderlying(Reloc.Header.Type));
+      return nullptr;
+    }
+    NumDataSlots += Count;
+  }
+  if (NumDataSlots * sizeof(uint64_t) > MetaHeader.DataSize) {
+    LogMan::Msg::EFmt("AOT image data area is too small");
+    return nullptr;
+  }
+
+  // The data area is ordinary memory of the image, written directly (not through the JIT pool's RW alias).
+  const auto NumLinkRecords = FillAOTDataArea(Relocations, reinterpret_cast<uint64_t*>(Data), Code, FileStartVA, true,
+                                              FEXCore::Context::DATA_ONLY_LINK_RECORD_LINKED);
+  LogMan::Msg::IFmt("[aot-image] linked: code {} bytes at {}, data area {} slots ({} link records) at {}", header.CodeBufferSize,
+                    fmt::ptr(Code), NumDataSlots, NumLinkRecords, fmt::ptr(Data));
+
+  size_t NumPages = header.CodeBufferSize / Utils::FEX_PAGE_SIZE;
+  auto PageRelocationRanges = GroupRelocationsByPage(CacheFile, Relocations, NumPages);
+
+  // CodeBufferInFile is empty and ends where the code ended in the cache file,
+  // which is where EnableLoadedSection reads the code page entries from.
+  // Every page counts as loaded, so FinalizeCodePages never touches the code.
+  auto Storage = FEXCore::Allocator::aligned_alloc(alignof(MappedCodeCacheFile), sizeof(MappedCodeCacheFile));
+  auto Result = fextl::unique_ptr<MappedCodeCacheFile>(new (Storage) MappedCodeCacheFile {
+    this, CacheFile, std::span {CacheFile.data() + MetaHeader.CodeOffset, 0}, std::span {Code, header.CodeBufferSize}, BlockListStart,
+    header.NumBlocks, header.NumCodePages, std::move(PageRelocationRanges), fextl::vector<bool>(NumPages, true), FileStartVA});
+  Result->ReadOnlyCode = true;
+  return Result;
+#else
+  return nullptr;
+#endif
+}
