+bool ImageTracker::LoadLinkedImageCache(const MappedImageInfo& Image, std::string_view ID, uint64_t Address, uint64_t Size) {
+  const auto* Index = GetAOTIndex();
+  if (!Index) {
+    return false;
+  }
+  const AOTIndexEntry* Entry = nullptr;
+  for (uint64_t i = 0; i < Index->NumEntries; ++i) {
+    if (Index->Entries()[i].FileId == Image.Info.FileId && Index->Entries()[i].ConfigId == 0) {
+      Entry = &Index->Entries()[i];
+      break;
+    }
+  }
+  if (!Entry) {
+    LogMan::Msg::EFmt("[aot-image] no linked cache for {}", ID);
+    return false;
+  }
+
+  const uint64_t GuestBase = Guest32Base();
+  auto Cache = CTX.GetCodeCache().LoadLinkedCache(Entry->Meta, Entry->Text, Entry->Data, Image.Info, Address - GuestBase);
+  if (!Cache) {
+    LogMan::Msg::EFmt("[aot-image] linked cache for {} rejected by FEXCore", ID);
+    return false;
+  }
+  CTX.GetCodeCache().RegisterMappedCodeBuffer(*Cache);
+  LogMan::Msg::EFmt("[aot-image] loaded linked cache for {}: code {} bytes at {} for guest {:#x}", ID, Cache->CodeBuffer.size_bytes(),
+                    fmt::ptr(Entry->Text), Address - GuestBase);
+
+  std::scoped_lock Lk {LoadedCachesLock};
+  LoadedCaches.push_back({std::move(Cache), &Image, Address - GuestBase, Address - GuestBase + Size, false});
+  return true;
+}
