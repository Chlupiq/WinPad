+// WinPad: drops the NoJIT interpreter's IR of every block with a code page in [Start, Start + Length).
+void ContextImpl::InterpCacheInvalidateRange(uint64_t Start, uint64_t Length) {
+  std::scoped_lock lk {InterpCacheLock};
+  if (InterpCache.empty()) {
+    return;
+  }
+  const uint64_t End = Length > std::numeric_limits<uint64_t>::max() - Start ? std::numeric_limits<uint64_t>::max() : Start + Length;
+  uint64_t Dropped = 0;
+  for (auto It = InterpCache.begin(); It != InterpCache.end();) {
+    const auto& Pages = It->second->CodePages;
+    const bool Hit = std::any_of(Pages.begin(), Pages.end(), [&](uint64_t Page) {
+      return Page < End && Page + FEXCore::Utils::FEX_PAGE_SIZE > Start;
+    });
+    if (Hit) {
+      It = InterpCache.erase(It);
+      ++Dropped;
+    } else {
+      ++It;
+    }
+  }
+  if (Dropped) {
+    InterpCacheDropped.fetch_add(Dropped, std::memory_order_relaxed);
+  }
+}
