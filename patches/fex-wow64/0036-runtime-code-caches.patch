+// WinPad: the id of runtime code, from its bytes and guest address: the AOT image's code for it
+// holds both (guest addresses the code jumps to and loads from are constants in it).
+static FEXCore::CodeMapFileId ComputeRuntimeCodeId(uint64_t HostAddress, uint64_t Size, uint64_t GuestAddress) {
+  auto Id = XXH3_64bits_withSeed(reinterpret_cast<const void*>(HostAddress), Size, GuestAddress ^ (Size << 32));
+  // 0 means "no id yet", and ~0 is no file at all to the code map.
+  return Id == 0 || Id == ~0ULL ? 1 : Id;
+}
+
+void ImageTracker::HandleRuntimeCodeProtect(uint64_t Address, uint64_t Size, bool Executable) {
+  if (!Size) {
+    return;
+  }
+  ForgetRuntimeCode(Address, Address + Size);
+  if (!Executable || IsGeneratingCache || !FEXCore::Config::Get_ENABLECODECACHINGWIP()) {
+    return;
+  }
+  {
+    std::shared_lock Lk {ImagesLock};
+    auto It = MappedImages.upper_bound(Address);
+    if (It != MappedImages.begin() && std::prev(It)->second.SectionInfo.EndVA > Address) {
+      // A page of an image (a hook installer's VirtualProtect): ImageTracker knows it already.
+      return;
+    }
+  }
+  std::unique_lock Lk {RuntimeCodeLock};
+  RuntimeCode[Address] = {Address + Size, 0, false};
+  HasRuntimeCode.store(true, std::memory_order_relaxed);
+}
+
+void ImageTracker::HandleRuntimeCodeFree(uint64_t Address, uint64_t Size) {
+  ForgetRuntimeCode(Address, Address + Size);
+}
+
+void ImageTracker::ForgetRuntimeCode(uint64_t Begin, uint64_t End) {
+  if (!HasRuntimeCode.load(std::memory_order_relaxed)) {
+    return;
+  }
+  fextl::vector<uint64_t> Forgotten;
+  {
+    std::unique_lock Lk {RuntimeCodeLock};
+    auto It = RuntimeCode.upper_bound(Begin);
+    if (It != RuntimeCode.begin() && std::prev(It)->second.End > Begin) {
+      --It;
+    }
+    while (It != RuntimeCode.end() && It->first < End) {
+      if (It->second.FileId) {
+        Forgotten.push_back(It->first);
+      }
+      It = RuntimeCode.erase(It);
+    }
+  }
+  if (Forgotten.empty()) {
+    return;
+  }
+  std::unique_lock Lk {ImagesLock};
+  std::scoped_lock CachesLk {LoadedCachesLock};
+  for (auto Address : Forgotten) {
+    auto It = MappedImages.find(Address);
+    if (It == MappedImages.end()) {
+      continue;
+    }
+    for (auto& Loaded : LoadedCaches) {
+      if (Loaded.Image == &It->second) {
+        Loaded.Image = nullptr;
+      }
+    }
+    MappedImages.erase(It);
+  }
+}
+
+FEXCore::HLE::SyscallHandler::RuntimeCodeState ImageTracker::QueryRuntimeCode(uint64_t Address) {
+  using State = FEXCore::HLE::SyscallHandler::RuntimeCodeState;
+  if (!HasRuntimeCode.load(std::memory_order_relaxed)) {
+    return State::None;
+  }
+  std::shared_lock Lk {RuntimeCodeLock};
+  auto It = RuntimeCode.upper_bound(Address);
+  if (It == RuntimeCode.begin() || std::prev(It)->second.End <= Address) {
+    return State::None;
+  }
+  const auto& Range = std::prev(It)->second;
+  return !Range.FileId ? State::Unprepared : Range.HasCache ? State::Cached : State::None;
+}
+
+void ImageTracker::WriteRuntimeCodeDump(std::string_view Name, FEXCore::CodeMapFileId FileId, uint64_t Address, uint64_t Size) {
+  // Next to the new code maps, which the offline compiler's process-all imports with it.
+  const auto Dir = fmt::format("{}codemap\\new\\runtime\\", FEX::Config::GetCacheDirectory());
+  std::error_code ec;
+  std::filesystem::create_directories(Dir, ec);
+  const auto Path = fmt::format("{}{}", Dir, Name);
+  if (std::filesystem::exists(Path, ec)) {
+    return;
+  }
+  const int FD = _sopen(Path.c_str(), O_CREAT | O_TRUNC | O_WRONLY | O_BINARY, _SH_DENYRW, 0644);
+  if (FD == -1) {
+    LogMan::Msg::EFmt("[rt-code] cannot write {}", Path);
+    return;
+  }
+  const RuntimeCodeDumpHeader Header {
+    .Magic = {'F', 'X', 'R', 'C'}, .Version = 1, .GuestAddress = Address - Guest32Base(), .Size = Size, .FileId = FileId};
+  const bool Ok = _write(FD, &Header, sizeof(Header)) == static_cast<int>(sizeof(Header)) &&
+                  _write(FD, reinterpret_cast<const void*>(Address), static_cast<unsigned>(Size)) == static_cast<int>(Size);
+  _close(FD);
+  if (!Ok) {
+    LogMan::Msg::EFmt("[rt-code] short write to {}", Path);
+    std::filesystem::remove(Path, ec);
+  }
+}
+
+void ImageTracker::PrepareRuntimeCode(FEXCore::Core::InternalThreadState* Thread, uint64_t Address) {
+  uint64_t Begin, End;
+  FEXCore::CodeMapFileId OldFileId;
+  {
+    std::shared_lock Lk {RuntimeCodeLock};
+    auto It = RuntimeCode.upper_bound(Address);
+    if (It == RuntimeCode.begin() || std::prev(It)->second.End <= Address) {
+      return;
+    }
+    --It;
+    Begin = It->first;
+    End = It->second.End;
+    OldFileId = It->second.FileId;
+  }
+  for (uint64_t Page = Begin & FEXCore::Utils::FEX_PAGE_MASK; Page < End; Page += FEXCore::Utils::FEX_PAGE_SIZE) {
+    if (!IsReadablePage(Page)) {
+      return;
+    }
+  }
+
+  const uint64_t GuestBase = Guest32Base();
+  const uint64_t GuestBegin = Begin - GuestBase;
+  const uint64_t Size = End - Begin;
+  const auto FileId = ComputeRuntimeCodeId(Begin, Size, GuestBegin);
+  static std::atomic<uint32_t> Reports {0};
+
+  if (FileId == OldFileId) {
+    // An invalidation dropped blocks of the cache (a write to other data on its pages, say), and
+    // the bytes are what they were: the cache is valid, register its blocks again.
+    // ForgetRuntimeCode clears Image under LoadedCachesLock before the image goes.
+    std::scoped_lock CachesLk {LoadedCachesLock};
+    for (auto& Loaded : LoadedCaches) {
+      if (Loaded.RuntimeCode && Loaded.Image && Loaded.Image->Info.FileId == FileId && Loaded.GuestBegin == GuestBegin) {
+        const FEXCore::ExecutableFileSectionInfo Section {Loaded.Image->Info, GuestBegin, GuestBegin, GuestBegin + Size};
+        CTX.GetCodeCache().EnableLoadedSection(Thread, *Loaded.Cache, Section);
+        if (Reports.fetch_add(1, std::memory_order_relaxed) < 64) {
+          LogMan::Msg::EFmt("[rt-code] {}: blocks registered again after an invalidation, bytes unchanged", Loaded.Image->Info.Filename);
+        }
+      }
+    }
+    return;
+  }
+
+  // New code, or other code where earlier code was.
+  ForgetRuntimeCode(Begin, End);
+  const auto Name = fmt::format("rtcode-{:08x}-{:016x}.fexrc", GuestBegin, FileId);
+  const MappedImageInfo* Image;
+  {
+    std::unique_lock Lk {ImagesLock};
+    auto [It, Inserted] = MappedImages.emplace(std::piecewise_construct, std::forward_as_tuple(Begin),
+                                               std::forward_as_tuple(FileId, Name, Begin, Size));
+    if (!Inserted) {
+      return;
+    }
+    Image = &It->second;
+  }
+
+  bool HasCache = false;
+  if (const auto* Entry = FEXCore::AOTIndex::Get() ? FEXCore::AOTIndex::Find(FileId, 0) : nullptr) {
+    auto Cache = CTX.GetCodeCache().LoadLinkedCache(Entry->Meta, Entry->Text, Entry->Data, Image->Info, GuestBegin);
+    if (Cache) {
+      CTX.GetCodeCache().RegisterMappedCodeBuffer(*Cache);
+      const FEXCore::ExecutableFileSectionInfo Section {Image->Info, GuestBegin, GuestBegin, GuestBegin + Size};
+      CTX.GetCodeCache().EnableLoadedSection(Thread, *Cache, Section);
+      std::scoped_lock CachesLk {LoadedCachesLock};
+      LoadedCaches.push_back({std::move(Cache), Image, GuestBegin, GuestBegin + Size, true, {}, true});
+      HasCache = true;
+    }
+  }
+
+  // The offline compiler needs the bytes of code the code map can get blocks of.
+  const bool Recording = !ActiveCodeMapPath.empty();
+  if (Recording && !HasCache) {
+    WriteRuntimeCodeDump(Name, FileId, Begin, Size);
+  }
+
+  {
+    std::unique_lock Lk {RuntimeCodeLock};
+    // Back in the map: ForgetRuntimeCode above took the range out with the old id.
+    RuntimeCode[Begin] = {End, FileId, HasCache};
+  }
+  if (Reports.fetch_add(1, std::memory_order_relaxed) < 64) {
+    LogMan::Msg::EFmt("[rt-code] {} bytes at guest {:#x} made executable at run time: {}, {}", Size, GuestBegin, Name,
+                      HasCache ? "code cache from the AOT image" :
+                      Recording ? "not in the AOT image, its bytes saved with the code map" :
+                                  "not in the AOT image");
+  }
