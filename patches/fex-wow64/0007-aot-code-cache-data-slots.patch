+
 void Arm64JITCore::InsertGuestRIPMove(ARMEmitter::Register Reg, uint64_t Constant) {
+  if (EmitAOTCode()) {
+    Relocation SlotABI {};
+    SlotABI.GuestRIP.Header = {.Offset = GetCursorOffset(), .Type = FEXCore::CPU::RelocationTypes::RELOC_GUEST_RIP_DATA_SLOT};
+    SlotABI.GuestRIP.GuestRIP = Constant;
+    SlotABI.GuestRIP.RegisterIndex = Reg.Idx();
+
+    // adrp Reg, slot; ldr Reg, [Reg, :lo12:slot]
+    // Immediates are filled in when the code cache is serialized.
+    dc32(0x90000000U | Reg.Idx());
+    dc32(0xF9400000U | (Reg.Idx() << 5) | Reg.Idx());
+    Relocations.emplace_back(SlotABI);
+    return;
+  }
+
   Relocation MoveABI {};
   MoveABI.GuestRIP.Header = {.Offset = GetCursorOffset(), .Type = FEXCore::CPU::RelocationTypes::RELOC_GUEST_RIP_MOVE};
   // NOTE: Cache serialization will subtract the guest binary base address later to produce consistency results
