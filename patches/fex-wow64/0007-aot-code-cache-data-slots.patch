+// Offset of the data area from the start of the code buffer in an AOT code cache
+constexpr uint64_t AOTDataAreaOffset(uint64_t CodeSize) {
+  constexpr uint64_t Alignment = 0x4000; // Largest host page size (iOS)
+  return (CodeSize + Alignment - 1) & ~(Alignment - 1);
+}
