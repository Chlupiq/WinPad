--- /dev/null
+++ b/FEXCore/include/FEXCore/Core/AOTIndex.h
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+// WinPad: index of an AOT image, code built ahead of time and linked into the app
+// (tools/cache2macho, index from tools/cache2macho/aotindex.py). The host publishes its
+// address in WINE_IOS_AOT_INDEX; the code is in the app's signed text and runs in place.
+#include <FEXCore/Utils/LogManager.h>
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace FEXCore::AOTIndex {
+struct Entry {
+  uint64_t FileId;
+  uint64_t ConfigId;
+  const std::byte* Meta;
+  std::byte* Text;
+  std::byte* Data;
+};
+
+struct Index {
+  char Magic[4];
+  uint32_t Version;
+  uint64_t NumEntries;
+  // Followed by NumEntries Entry
+
+  const Entry* Entries() const {
+    return reinterpret_cast<const Entry*>(this + 1);
+  }
+};
+static_assert(sizeof(Index) == 16 && sizeof(Entry) == 40);
+
+// The dispatcher's entry: file id 0, this config id; Meta is its "FXAD" header, Data is unused.
+constexpr uint64_t DispatcherFileId = 0;
+constexpr uint64_t DispatcherConfigId = ~0ULL;
+
+inline const Index* Get() {
+  static const Index* Result = []() -> const Index* {
+    const char* Env = getenv("WINE_IOS_AOT_INDEX");
+    if (!Env || !*Env) {
+      return nullptr;
+    }
+    auto* Index = reinterpret_cast<const AOTIndex::Index*>(strtoull(Env, nullptr, 16));
+    if (!Index || memcmp(Index->Magic, "FXAI", 4) != 0 || Index->Version != 1) {
+      LogMan::Msg::EFmt("[aot-image] WINE_IOS_AOT_INDEX={} is not an AOT image index", Env);
+      return nullptr;
+    }
+    LogMan::Msg::EFmt("[aot-image] index at {}: {} entries", static_cast<const void*>(Index), Index->NumEntries);
+    return Index;
+  }();
+  return Result;
+}
+
+inline const Entry* Find(uint64_t FileId, uint64_t ConfigId) {
+  const auto* Index = Get();
+  if (!Index) {
+    return nullptr;
+  }
+  for (uint64_t i = 0; i < Index->NumEntries; ++i) {
+    if (Index->Entries()[i].FileId == FileId && Index->Entries()[i].ConfigId == ConfigId) {
+      return &Index->Entries()[i];
+    }
+  }
+  return nullptr;
+}
+} // namespace FEXCore::AOTIndex
