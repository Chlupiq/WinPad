+void Dispatcher::DumpCode() {
+  // WinPad: input of tools/cache2macho --dispatcher, which puts the code into the AOT image
+  FEX_CONFIG_OPT(DumpDispatcher, DUMPDISPATCHER);
+  if (DumpDispatcher().empty()) {
+    return;
+  }
+  const auto Size = End - reinterpret_cast<uint64_t>(GetBufferBase());
+  auto* File = fopen(DumpDispatcher().c_str(), "wb");
+  if (!File || fwrite(GetBufferBase(), 1, Size, File) != Size) {
+    LogMan::Msg::EFmt("[aot-dispatcher] failed to write dispatcher code to {}", DumpDispatcher());
+  } else {
+    LogMan::Msg::EFmt("[aot-dispatcher] wrote {} bytes of dispatcher code to {}", Size, DumpDispatcher());
+  }
+  if (File) {
+    fclose(File);
+  }
+}
+
+bool Dispatcher::UseStaticCode() {
+  // The image holds the dispatcher as dumped with DumpDispatcher. Its code has no absolute
+  // addresses, so it is only used if it is byte for byte what this FEX build and configuration
+  // just generated; then every entry point moves to the image's copy.
+  const auto* Entry = FEXCore::AOTIndex::Find(FEXCore::AOTIndex::DispatcherFileId, FEXCore::AOTIndex::DispatcherConfigId);
+  if (!Entry) {
+    return false;
+  }
+  struct {
+    char Magic[4];
+    uint32_t Version;
+    uint64_t Size;
+  } Header {};
+  memcpy(&Header, Entry->Meta, sizeof(Header));
+  const auto Base = reinterpret_cast<uint64_t>(GetBufferBase());
+  const auto Size = End - Base;
+  if (memcmp(Header.Magic, "FXAD", 4) != 0 || Header.Version != 1) {
+    LogMan::Msg::EFmt("[aot-dispatcher] invalid dispatcher header in the AOT image; generating it");
+    return false;
+  }
+  if (Header.Size != Size || memcmp(Entry->Text, GetBufferBase(), Size) != 0) {
+    size_t FirstDiff = 0;
+    while (FirstDiff < std::min<uint64_t>(Size, Header.Size) && Entry->Text[FirstDiff] == reinterpret_cast<const std::byte*>(GetBufferBase())[FirstDiff]) {
+      ++FirstDiff;
+    }
+    LogMan::Msg::EFmt("[aot-dispatcher] image's dispatcher ({} bytes) differs from this build and configuration ({} bytes) at {:#x}; "
+                      "generating it",
+                      Header.Size, Size, FirstDiff);
+    return false;
+  }
+
+  const auto Delta = reinterpret_cast<uint64_t>(Entry->Text) - Base;
+  auto Move = [Delta](uint64_t& Address) {
+    if (Address) {
+      Address += Delta;
+    }
+  };
+  DispatchPtr = reinterpret_cast<AsmDispatch>(reinterpret_cast<uint64_t>(DispatchPtr) + Delta);
+  CallbackPtr = reinterpret_cast<JITCallback>(reinterpret_cast<uint64_t>(CallbackPtr) + Delta);
+  for (auto* Address :
+       {&ThreadStopHandlerAddress, &ThreadStopHandlerAddressSpillSRA, &AbsoluteLoopTopAddress, &AbsoluteLoopTopAddressFillSRA,
+        &AbsoluteLoopTopAddressEnterEC, &AbsoluteLoopTopAddressEnterECFillSRA, &ThreadPauseHandlerAddress, &ThreadPauseHandlerAddressSpillSRA,
+        &ExitFunctionLinkerAddress, &SignalHandlerReturnAddress, &SignalHandlerReturnAddressRT, &GuestSignal_SIGILL, &GuestSignal_SIGTRAP,
+        &GuestSignal_SIGSEGV, &PauseReturnInstruction, &Start, &End, &LUDIVHandlerAddress, &LDIVHandlerAddress, &F64SinHandlerAddress,
+        &F64CosHandlerAddress, &F64TanHandlerAddress, &F64F2XM1HandlerAddress, &F64ScaleHandlerAddress, &F64AtanHandlerAddress,
+        &F64FYL2XHandlerAddress, &F64FYL2XP1HandlerAddress, &F64FPREMHandlerAddress, &F64FPREM1HandlerAddress}) {
+    Move(*Address);
+  }
+  for (auto& Address : ABIPointers) {
+    Move(Address);
+  }
+  LogMan::Msg::EFmt("[aot-dispatcher] static code from the AOT image, {} bytes at {}", Size, static_cast<const void*>(Entry->Text));
+  return true;
+}
