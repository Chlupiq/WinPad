+void ContextImpl::NoteUnalignedAOTBlock(FEXCore::Core::InternalThreadState* Thread) {
+  UnalignedAOTFaults.fetch_add(1, std::memory_order_relaxed);
+  const uint64_t GuestRIP = GetGuestBlockEntry(Thread);
+  if (!GuestRIP) {
+    return;
+  }
+  bool New;
+  size_t Count;
+  {
+    std::scoped_lock lk(UnalignedAOTLock);
+    New = UnalignedAOTBlocks.insert(GuestRIP).second;
+    Count = UnalignedAOTBlocks.size();
+  }
+  if (!New) {
+    return;
+  }
+  if (Count <= 64) {
+    LogMan::Msg::EFmt("[aot-unaligned] block {:#x} of the AOT image took an unaligned atomic fault; recorded for a "
+                      "half-barrier compile",
+                      GuestRIP);
+  }
+  if (CodeMapWriter) {
+    auto Region = SyscallHandler->LookupExecutableFileSection(Thread, GuestRIP);
+    if (Region && Region->FileStartVA != 0) {
+      CodeMapWriter->AppendBlock(*Region, GuestRIP, CodeMap::HalfBarrierTSOBlock);
+    }
+  }
+}
