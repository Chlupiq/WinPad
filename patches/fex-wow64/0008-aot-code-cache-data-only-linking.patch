+static void DataOnlyBlockDelinker(FEXCore::Context::ExitFunctionLinkData* Record) {
+  // The thunk falls back to the exit linker once HostCode is zero again.
+  std::atomic_ref<uint64_t>(FEXCore::DualMap::WriteAddr(Record)->HostCode).store(0, std::memory_order::seq_cst);
