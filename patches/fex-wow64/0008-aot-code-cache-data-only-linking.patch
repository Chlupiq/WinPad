+// Number of 8-byte data area slots a relocation takes in an AOT code cache
+constexpr uint64_t AOTDataSlotCount(RelocationTypes Type) {
+  switch (Type) {
+  case RelocationTypes::RELOC_GUEST_RIP_DATA_SLOT: return 1;
+  case RelocationTypes::RELOC_GUEST_RIP_LINK_RECORD: return 3;
+  default: return 0;
+  }
