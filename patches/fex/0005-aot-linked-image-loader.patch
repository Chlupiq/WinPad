+// Looks up the AOT cache for a binary in a shared object made by WinPad's
+// cache2macho --elf-asm. Its symbols are named after the cache file
+// (<binary>-<file id>-<config id>), so one image can hold caches for several
+// binaries. The image stays loaded for the life of the process.
+static fextl::unique_ptr<FEXCore::MappedCodeCacheFile>
+LoadLinkedCodeCache(FEXCore::Core::InternalThreadState& Thread, const fextl::string& ImagePath, const FEXCore::ExecutableFileInfo& FileInfo,
+                    uint64_t CodeCacheConfigId, uint64_t FileStartVA) {
+  auto* Handle = dlopen(ImagePath.c_str(), RTLD_NOW | RTLD_LOCAL);
+  if (!Handle) {
+    LogMan::Msg::EFmt("Failed to load AOT image {}: {}", ImagePath, dlerror());
+    return nullptr;
+  }
+
+  auto Prefix = fextl::fmt::format("fexaot_{:016x}_{:016x}", FileInfo.FileId, CodeCacheConfigId);
+  auto* Meta = dlsym(Handle, fextl::fmt::format("{}_meta", Prefix).c_str());
+  auto* Code = dlsym(Handle, fextl::fmt::format("{}_text", Prefix).c_str());
+  auto* Data = dlsym(Handle, fextl::fmt::format("{}_data", Prefix).c_str());
+  if (!Meta || !Code || !Data) {
+    LogMan::Msg::IFmt("AOT image {} has no code for {}", ImagePath, Prefix);
+    dlclose(Handle);
+    return nullptr;
+  }
+
+  auto Result = Thread.CTX->GetCodeCache().LoadLinkedCache(static_cast<const std::byte*>(Meta), static_cast<std::byte*>(Code),
+                                                           static_cast<std::byte*>(Data), FileInfo, FileStartVA);
+  if (!Result) {
+    dlclose(Handle);
+  }
+  return Result;
+}
