+// Fills an AOT data area: slots in relocation order (see CPU::AOTDataSlotCount).
+// Block tails are copied from Code, which holds the code as stored in the cache.
+// Returns the number of block link records.
+static size_t FillAOTDataArea(std::span<const CPU::Relocation> Relocations, uint64_t* Slot, const std::byte* Code, uint64_t FileStartVA,
+                              bool ReadOnlyCode) {
+  size_t NumLinkRecords = 0;
+  for (const auto& Reloc : Relocations) {
+    if (Reloc.Header.Type == CPU::RelocationTypes::RELOC_GUEST_RIP_DATA_SLOT) {
+      *Slot++ = FileStartVA + Reloc.GuestRIP.GuestRIP;
+    } else if (Reloc.Header.Type == CPU::RelocationTypes::RELOC_GUEST_RIP_LINK_RECORD) {
+      static_assert(sizeof(FEXCore::Context::ExitFunctionLinkData) == 3 * sizeof(uint64_t));
+      auto* Record = reinterpret_cast<FEXCore::Context::ExitFunctionLinkData*>(Slot);
+      Record->HostCode = 0;
+      Record->GuestRIP = FileStartVA + Reloc.GuestRIP.GuestRIP;
+      Record->CallerOffset = FEXCore::Context::DATA_ONLY_LINK_RECORD;
+      Slot += 3;
+      ++NumLinkRecords;
+    } else if (Reloc.Header.Type == CPU::RelocationTypes::RELOC_AOT_BLOCK_TAIL) {
+      memcpy(Slot, Code + Reloc.Header.Offset, Reloc.AOTBlockTail.TailSize);
+      auto* Tail = reinterpret_cast<CPU::CPUBackend::JITCodeTail*>(Slot);
+      Tail->RIP = FileStartVA + Reloc.AOTBlockTail.GuestRIP;
+      Tail->SpinLockFutex = 0;
+      Tail->ReadOnlyCode = ReadOnlyCode;
+      Slot += CPU::AOTDataSlotCount(Reloc);
+    }
   }
+  return NumLinkRecords;
+}
 
