+bool Dispatcher::UseStaticCode(const fextl::string& ImagePath) {
+#ifdef _WIN32
+  return false;
+#else
+  // The image holds the dispatcher as dumped with DumpDispatcher (WinPad
+  // tools/cache2macho --dispatcher). Its code has no absolute addresses, so it
+  // is only used if it is byte for byte what this FEX build and configuration
+  // just generated; then every entry point moves to the image's copy.
+  auto* Handle = dlopen(ImagePath.c_str(), RTLD_NOW | RTLD_LOCAL);
+  if (!Handle) {
+    LogMan::Msg::EFmt("Failed to load AOT image {}: {}", ImagePath, dlerror());
+    return false;
+  }
+  auto* Meta = static_cast<const std::byte*>(dlsym(Handle, "fexaot_dispatcher_meta"));
+  auto* Code = static_cast<const std::byte*>(dlsym(Handle, "fexaot_dispatcher_text"));
+  struct {
+    char Magic[4];
+    uint32_t Version;
+    uint64_t Size;
+  } Header {};
+  if (Meta) {
+    memcpy(&Header, Meta, sizeof(Header));
+  }
+  const auto Base = reinterpret_cast<uint64_t>(GetBufferBase());
+  const auto Size = End - Base;
+  if (!Meta || !Code || memcmp(Header.Magic, "FXAD", 4) != 0 || Header.Version != 1) {
+    LogMan::Msg::IFmt("AOT image {} has no dispatcher; generating it", ImagePath);
+    dlclose(Handle);
+    return false;
+  }
+  if (Header.Size != Size || memcmp(Code, GetBufferBase(), Size) != 0) {
+    LogMan::Msg::EFmt("Dispatcher in AOT image {} differs from this FEX build and configuration; generating it", ImagePath);
+    dlclose(Handle);
+    return false;
+  }
+
+  const auto Delta = reinterpret_cast<uint64_t>(Code) - Base;
+  auto Move = [Delta](uint64_t& Address) {
+    if (Address) {
+      Address += Delta;
+    }
+  };
+  DispatchPtr = reinterpret_cast<AsmDispatch>(reinterpret_cast<uint64_t>(DispatchPtr) + Delta);
+  CallbackPtr = reinterpret_cast<JITCallback>(reinterpret_cast<uint64_t>(CallbackPtr) + Delta);
+  for (auto* Address :
+       {&ThreadStopHandlerAddress, &ThreadStopHandlerAddressSpillSRA, &AbsoluteLoopTopAddress, &AbsoluteLoopTopAddressFillSRA,
+        &AbsoluteLoopTopAddressEnterEC, &AbsoluteLoopTopAddressEnterECFillSRA, &ThreadPauseHandlerAddress, &ThreadPauseHandlerAddressSpillSRA,
+        &ThreadDispatchSyscallHandler, &ThreadDispatchRemoveCodeEntry, &ExitFunctionLinkerAddress, &SignalHandlerReturnAddress,
+        &SignalHandlerReturnAddressRT, &GuestSignal_SIGILL, &GuestSignal_SIGTRAP, &GuestSignal_SIGSEGV, &PauseReturnInstruction, &Start, &End,
+        &LUDIVHandlerAddress, &LDIVHandlerAddress, &F64SinHandlerAddress, &F64CosHandlerAddress, &F64TanHandlerAddress,
+        &F64F2XM1HandlerAddress, &F64ScaleHandlerAddress, &F64AtanHandlerAddress, &F64FYL2XHandlerAddress, &F64FYL2XP1HandlerAddress,
+        &F64FPREMHandlerAddress, &F64FPREM1HandlerAddress}) {
+    Move(*Address);
+  }
+  for (auto& Address : ABIPointers) {
+    Move(Address);
+  }
+  LogMan::Msg::IFmt("Dispatcher: static code from AOT image, {} bytes at {}", Size, fmt::ptr(Code));
+  return true;
+#endif
+}
+
 fextl::unique_ptr<Dispatcher> Dispatcher::Create(FEXCore::Context::ContextImpl* CTX) {
   return fextl::make_unique<Dispatcher>(CTX);
 }
