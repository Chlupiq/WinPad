 void* aligned_alloc(size_t a, size_t s) {
+#ifdef __APPLE__
+  // Darwin's aligned_alloc returns null unless the size is a multiple of the
+  // alignment, which fextl's allocations do not guarantee.
+  void* r {};
+  return ::posix_memalign(&r, a < sizeof(void*) ? sizeof(void*) : a, s) == 0 ? r : nullptr;
+#else
   return ::aligned_alloc(a, s);
+#endif
 }
