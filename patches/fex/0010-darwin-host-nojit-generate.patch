+// With NoJIT the generated dispatcher never runs, so it needs no executable
+// memory either (cache generation dumps it for an AOT image).
+static bool DispatcherExecutable() {
+  FEX_CONFIG_OPT(NoJIT, NOJIT);
+  return !WantsStaticCode() && !NoJIT();
+}
