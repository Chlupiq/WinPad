+void Arm64JITCore::InsertGuestRIPLinkRecord(ARMEmitter::Register Reg, uint64_t GuestRIP) {
+  Relocation RecordABI {};
+  RecordABI.GuestRIP.Header = {.Offset = GetCursorOffset(), .Type = FEXCore::CPU::RelocationTypes::RELOC_GUEST_RIP_LINK_RECORD};
+  RecordABI.GuestRIP.GuestRIP = GuestRIP;
+  RecordABI.GuestRIP.RegisterIndex = Reg.Idx();
+
+  // adrp Reg, record; add Reg, Reg, :lo12:record
+  // Immediates are filled in when the code cache is serialized.
+  dc32(0x90000000U | Reg.Idx());
+  dc32(0x91000000U | (Reg.Idx() << 5) | Reg.Idx());
+  Relocations.emplace_back(RecordABI);
+}
